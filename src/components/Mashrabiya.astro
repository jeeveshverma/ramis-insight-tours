---
/**
 * Mashrabiya: the turned-wood screens of old Cairo houses — rows of vertical spindles strung with beads, tied by
 * thin rails, small openings between. (Drawn as turned work, not a diagonal grid, which reads as a wire fence.)
 * variant 'screen'  — gold lattice on a dark ground with a slow sweep of sunlight crossing it (hero, night sections)
 * variant 'shadow'  — the soft shadow such a screen throws on a sunlit wall, drifting as the sun moves (light sections)
 * Purely decorative and absolutely positioned; give the parent position: relative.
 */
interface Props { variant?: 'screen' | 'shadow'; class?: string; id?: string; fade?: 'left' | 'right' | 'center' | 'none' }
const { variant = 'screen', class: cls = '', id = `m${Math.random().toString(36).slice(2, 7)}`, fade = 'none' } = Astro.props;
---
<svg class={`mash mash-${variant} mash-fade-${fade} ${cls}`} aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <defs>
    <!-- one cell of turned work: a spindle with a long bead and a round bead, a rail, and half-beads at the edges -->
    <pattern id={`${id}-p`} width="22" height="40" patternUnits="userSpaceOnUse">
      <rect x="10.2" y="0" width="1.6" height="40" />
      <ellipse cx="11" cy="9" rx="3" ry="5.2" />
      <circle cx="11" cy="23" r="2.6" />
      <rect x="0" y="30.4" width="22" height="1.2" />
      <circle cx="11" cy="31" r="1.9" />
      <circle cx="0" cy="31" r="1.3" /><circle cx="22" cy="31" r="1.3" />
      <rect x="2.2" y="16" width="2" height="0.9" rx="0.4" /><rect x="17.8" y="16" width="2" height="0.9" rx="0.4" />
    </pattern>
    {variant === 'screen' && (
      <>
        <linearGradient id={`${id}-sun`} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#fff" stop-opacity="0" />
          <stop offset="0.5" stop-color="#fff" stop-opacity="1" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <mask id={`${id}-m`}><rect class="mash-sweep" x="-40%" y="0" width="40%" height="100%" fill={`url(#${id}-sun)`} /></mask>
      </>
    )}
    {variant === 'shadow' && <filter id={`${id}-b`}><feGaussianBlur stdDeviation="2.2" /></filter>}
  </defs>
  {variant === 'screen' ? (
    <>
      <rect class="mash-base" width="100%" height="100%" fill={`url(#${id}-p)`} />
      <rect class="mash-glint" width="100%" height="100%" fill={`url(#${id}-p)`} mask={`url(#${id}-m)`} />
    </>
  ) : (
    <g class="mash-drift"><rect x="-10%" y="-10%" width="120%" height="120%" fill={`url(#${id}-p)`} filter={`url(#${id}-b)`} transform="skewX(-8)" /></g>
  )}
</svg>
<style>
  .mash { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  .mash-screen :global(pattern) { fill: var(--gold); }
  .mash-screen .mash-base { opacity: 0.075; }
  .mash-glint { opacity: 0.4; }
  .mash-sweep { animation: mash-sweep 18s ease-in-out infinite; }
  @keyframes mash-sweep { 0% { transform: translateX(0); } 100% { transform: translateX(350%); } }
  .mash-shadow { fill: var(--nile); opacity: 0.05; mix-blend-mode: multiply; }
  .mash-drift { animation: mash-drift 40s ease-in-out infinite alternate; }
  @keyframes mash-drift { from { transform: translate(0, 0); } to { transform: translate(-3%, 2%); } }
  /* fade the lattice out where text sits */
  .mash-fade-left { -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 35%, #000 80%); mask-image: linear-gradient(90deg, transparent 0%, transparent 35%, #000 80%); }
  .mash-fade-right { -webkit-mask-image: linear-gradient(-90deg, transparent 0%, transparent 35%, #000 80%); mask-image: linear-gradient(-90deg, transparent 0%, transparent 35%, #000 80%); }
  :global(html[dir='rtl']) .mash-fade-left { -webkit-mask-image: linear-gradient(-90deg, transparent 0%, transparent 35%, #000 80%); mask-image: linear-gradient(-90deg, transparent 0%, transparent 35%, #000 80%); }
  .mash-fade-center { -webkit-mask-image: radial-gradient(ellipse at center, transparent 20%, #000 70%); mask-image: radial-gradient(ellipse at center, transparent 20%, #000 70%); }
  @media (prefers-reduced-motion: reduce) { .mash-sweep, .mash-drift { animation: none; } .mash-glint { opacity: 0; } }
</style>
