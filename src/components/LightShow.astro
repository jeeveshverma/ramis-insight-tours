---
/**
 * The Giza sound-and-light show, re-staged on our own night photo from the rooftop: coloured floodlight washes
 * and a sweeping beam, clipped to the three pyramids so the light falls on the stone and nowhere else.
 * The mask is a vertical gradient (brightest at the base, where the floodlights are, fading to the apex) and is
 * blurred slightly so the edges read as light rather than paint. Coordinates are the photo's pixel space
 * (1345x896, rooftop-night-pyramids.jpg); xMidYMid slice crops exactly like the photo's object-fit: cover.
 * The apartment block in front of the middle pyramid is masked out so the light stays behind it.
 */
interface Props { id?: string }
const { id = 'ls' } = Astro.props;
const W = 1345, H = 896;
const P = {
  left: '315,538 260,588 372,588',
  middle: '640,463 556,588 752,588',
  great: '1100,425 943,588 1262,588',
};
---
<svg class="lightshow" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-fall`} x1="0" y1="425" x2="0" y2="590" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" stop-opacity="0.08" />
      <stop offset="0.55" stop-color="#fff" stop-opacity="0.45" />
      <stop offset="1" stop-color="#fff" stop-opacity="1" />
    </linearGradient>
    <filter id={`${id}-soft`} x="-5%" y="-5%" width="110%" height="110%"><feGaussianBlur stdDeviation="2.2" /></filter>
    <mask id={`${id}-m`} maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
      <rect width={W} height={H} fill="black" />
      <g filter={`url(#${id}-soft)`}>
        <polygon points={P.left} fill={`url(#${id}-fall)`} />
        <polygon points={P.middle} fill={`url(#${id}-fall)`} />
        <polygon points={P.great} fill={`url(#${id}-fall)`} />
      </g>
      <!-- the building in front of the middle pyramid -->
      <rect x="560" y="508" width="178" height="100" fill="black" />
    </mask>
    <linearGradient id={`${id}-beam`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.5" stop-color="#fff6d8" stop-opacity="0.75" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx="0.5" cy="1" r="0.8">
      <stop offset="0" stop-color="#fff" stop-opacity="0.9" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <g mask={`url(#${id}-m)`}>
    <!-- colour washes, one per pyramid, cycling out of phase like the show's lighting cues -->
    <rect class="ls-wash ls-w1" x="230" y="400" width="170" height="200" />
    <rect class="ls-wash ls-w2" x="540" y="400" width="230" height="200" />
    <rect class="ls-wash ls-w3" x="930" y="400" width="350" height="200" />
    <!-- a white beam sweeping across all three -->
    <rect class="ls-beam" x="0" y="380" width="220" height="240" fill={`url(#${id}-beam)`} />
    <!-- floodlight glow rising from the base of the Great Pyramid -->
    <ellipse class="ls-flood" cx="1100" cy="600" rx="200" ry="120" fill={`url(#${id}-glow)`} />
  </g>
</svg>

<style>
  .lightshow { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; mix-blend-mode: screen; z-index: 1; }
  .ls-wash { opacity: 0; animation: wash 12s ease-in-out infinite; }
  .ls-w1 { animation-delay: 0s; } .ls-w2 { animation-delay: 1.4s; } .ls-w3 { animation-delay: 2.8s; }
  /* gold -> lapis -> emerald -> magenta -> gold: the palette of the real show; kept below full strength so the stone shows through */
  @keyframes wash {
    0%, 100% { fill: #f0b43c; opacity: 0.5; }
    22% { fill: #4a7cf0; opacity: 0.55; }
    45% { fill: #34c48c; opacity: 0.45; }
    68% { fill: #d8459f; opacity: 0.5; }
    85% { fill: #f0b43c; opacity: 0.3; }
  }
  .ls-beam { animation: beam 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; transform-box: view-box; }
  @keyframes beam { 0% { transform: translateX(-260px); opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { transform: translateX(1400px); opacity: 0; } }
  .ls-flood { opacity: 0; animation: flood 12s ease-in-out infinite 6s; }
  @keyframes flood { 0%, 100% { opacity: 0; } 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) {
    .ls-wash, .ls-beam, .ls-flood { animation: none; }
    .ls-wash { fill: #e8b43a; opacity: 0.32; }
    .ls-beam, .ls-flood { opacity: 0; }
  }
</style>
