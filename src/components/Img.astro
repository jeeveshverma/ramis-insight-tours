---
/**
 * A catalogue photo through Astro's image pipeline (AVIF, srcset) with alt from src/data/photos.ts.
 * `ratio` crops with object-fit; `sizes` follows the layout slot.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photo } from '../data/photos';
import type { Lang } from '../i18n';

interface Props { id: string; lang: Lang; sizes?: string; widths?: number[]; ratio?: string; loading?: 'eager' | 'lazy'; priority?: boolean; class?: string; position?: string; quality?: number; alt?: string }
const { id, lang, sizes = '100vw', widths = [420, 640, 900, 1280], ratio, loading = 'lazy', priority = false, class: cls = '', position, quality = 64, alt } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,webp,png}', { eager: true });
const key = Object.keys(all).find((k) => k.replace(/^.*\//, '').replace(/\.[a-z]+$/, '') === id);
if (!key) throw new Error(`No photo file for id ${id}`);
const src = all[key].default;
const p = photo(id);
const style = [ratio ? `aspect-ratio:${ratio}` : '', position ? `--pos:${position}` : (p.pos ? `--pos:${p.pos}` : '')].filter(Boolean).join(';');
const ws = widths.filter((w) => w < src.width).concat(src.width);
---
<div class={`photo ${cls}`} style={style} data-photo={id}>
  <Image src={src} alt={alt ?? p.alt[lang]} widths={ws} sizes={sizes} format="avif" quality={quality} loading={priority ? 'eager' : loading} fetchpriority={priority ? 'high' : undefined} decoding={priority ? 'sync' : 'async'} />
</div>
<style>
  .photo img { object-position: var(--pos, 50% 50%); }
</style>
