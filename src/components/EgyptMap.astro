---
/**
 * A stylised SVG map of Egypt at true proportion (equirectangular, cos 27°). The coastline and the
 * Nile draw themselves when scrolled into view; destination pins pop in sequence. Optional `route`
 * traces a line through the itinerary's places in order, and pins carry data-place so a page can
 * highlight the current one (`.pin.active`) as the reader scrolls.
 */
import { PLACES, type PlaceId } from '../data/places';
import { path, pick, type Lang } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang; show?: PlaceId[]; route?: PlaceId[]; compact?: boolean; dark?: boolean; links?: boolean; focus?: PlaceId; traveller?: boolean }
const { lang, show, route, compact = false, dark = true, links = true, focus, traveller = false } = Astro.props;

const K = 40, CX = 24.3, TOP = 32.0, COS = 0.89;
const P = (lng: number, lat: number) => ({ x: (lng - CX) * K * COS, y: (TOP - lat) * K });
const pt = (c: [number, number]) => { const p = P(c[0], c[1]); return `${p.x.toFixed(1)} ${p.y.toFixed(1)}`; };
const W = Math.round((37.2 - CX) * K * COS), H = Math.round((TOP - 21.7) * K);

// Egypt outline (lng, lat), clockwise from Sallum
const OUTLINE: [number, number][] = [
  [25.15, 31.65], [26.4, 31.5], [27.4, 31.35], [28.5, 31.1], [29.2, 30.85], [29.9, 31.2], [30.4, 31.46], [31.0, 31.58], [31.5, 31.5], [32.3, 31.3], [32.9, 31.1], [33.6, 31.1], [34.22, 31.3],
  [34.27, 31.2], [34.5, 30.4], [34.9, 29.5], [34.72, 29.1], [34.62, 28.95], [34.5, 28.5], [34.42, 28.1], [34.33, 27.86], [34.25, 27.72], [34.0, 27.85], [33.7, 28.2], [33.3, 28.7], [33.0, 29.1], [32.7, 29.6], [32.56, 29.95],
  [32.4, 29.7], [32.5, 29.2], [32.7, 28.8], [33.0, 28.4], [33.4, 27.9], [33.8, 27.3], [33.95, 26.6], [34.3, 25.8], [34.65, 25.1], [35.2, 24.3], [35.6, 23.5], [35.85, 23.0], [36.2, 22.6], [36.9, 22.0],
  [25.0, 22.0], [25.0, 29.2], [24.7, 30.1], [25.15, 31.65],
];
const NILE: [number, number][] = [[32.89, 24.09], [32.93, 24.47], [32.87, 24.98], [32.55, 25.3], [32.64, 25.69], [32.72, 26.16], [32.24, 26.05], [31.69, 26.56], [31.18, 27.18], [30.9, 27.65], [30.75, 28.1], [31.1, 29.07], [31.24, 30.05]];
const ROSETTA: [number, number][] = [[31.24, 30.05], [30.9, 30.6], [30.5, 31.1], [30.4, 31.46]];
const DAMIETTA: [number, number][] = [[31.24, 30.05], [31.5, 30.6], [31.8, 31.2], [31.82, 31.52]];
const NASSER: [number, number][] = [[32.89, 24.09], [32.8, 23.5], [32.4, 23.0], [31.9, 22.4], [31.4, 22.0]];
const SUEZ: [number, number][] = [[32.56, 29.95], [32.33, 30.6], [32.3, 31.3]];
const line = (pts: [number, number][]) => 'M' + pts.map(pt).join(' L');

const visible = PLACES.filter((p) => !show || show.includes(p.id));
// Short labels: "Saqqara, Dahshur & Memphis" → "Saqqara". Abusir sits on top of Giza at this scale, so its label is
// dropped unless it is part of a route (the Sacred Egypt night) where it matters.
const pins = visible.map((p, i) => ({ ...p, pos: P(p.at.lng, p.at.lat), i, minor: p.minor && !(show?.includes(p.id)) && !(route?.includes(p.id)), quiet: p.id === 'abusir' && !route?.includes('abusir'), label: pick(p.short ?? p.name, lang) }));
const routePts = route?.map((id) => { const p = PLACES.find((x) => x.id === id)!; return [p.at.lng, p.at.lat] as [number, number]; });
const routeD = routePts && routePts.length > 1 ? 'M' + routePts.map(pt).join(' L') : '';
// Distance along the route polyline to each stop, in viewBox units; the traveller script interpolates between these.
const routeXY = (routePts ?? []).map(([lng, lat]) => P(lng, lat));
const cum = routeXY.reduce<number[]>((acc, p, i) => { acc.push(i ? acc[i - 1] + Math.hypot(p.x - routeXY[i - 1].x, p.y - routeXY[i - 1].y) : 0); return acc; }, []);
// The traveller's icons, on a 24-unit grid (same drawings as Icon.astro).
const TRAV: Record<string, string> = {
  plane: 'M3 13l8-1 3-7h2l-1 7 6 1v2l-6 1 1 5h-2l-3-5-8-1z',
  boat: 'M3 17h18l-2 3H5zM12 17V4M12 5c5 2 7 6 7 11M12 7c-3 2-5 5-5 9',
  camel: 'M4 19v-6l2-3 3 1 2-4 3-1 1 3h3l2-2v4l-2 1v7M8 19v-4M16 19v-4M6 13l-2-6',
  car: 'M5 15l1.5-5A2 2 0 0 1 8.4 8.5h7.2a2 2 0 0 1 1.9 1.5L19 15M3.5 15h17v4h-17zM7 19v1.5M17 19v1.5',
};
const lblOff = (s?: string) => s === 'l' ? { x: -9, y: 3.5, a: 'end' } : s === 'u' ? { x: 0, y: -9, a: 'middle' } : s === 'd' ? { x: 0, y: 14, a: 'middle' } : { x: 9, y: 3.5, a: 'start' };
const SEA = lang === 'ar' ? 'البحر المتوسط' : 'Mediterranean Sea';
const RED = lang === 'ar' ? 'البحر الأحمر' : 'Red Sea';
const NILE_L = lang === 'ar' ? 'النيل' : 'The Nile';
const focusP = focus ? PLACES.find((p) => p.id === focus) : undefined;
// A route that never leaves the north (Cairo, Alexandria, Fayoum) is a dot on the national map: zoom to it.
const routePlaces = route ? route.map((id) => PLACES.find((p) => p.id === id)!) : [];
const zoom = routePlaces.length > 1 && routePlaces.every((p) => p.at.lat > 28.9);
let VB = `0 0 ${W} ${H}`;
if (zoom) {
  const xs = routePlaces.map((p) => P(p.at.lng, p.at.lat).x), ys = routePlaces.map((p) => P(p.at.lng, p.at.lat).y);
  const cx = (Math.min(...xs) + Math.max(...xs)) / 2, cy = (Math.min(...ys) + Math.max(...ys)) / 2;
  const w = Math.max(220, (Math.max(...xs) - Math.min(...xs)) * 1.6), h = w * (H / W);
  VB = `${(cx - w / 2).toFixed(1)} ${(cy - h / 2).toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`;
}
---
<figure class:list={['emap', compact && 'emap-compact', dark ? 'emap-dark' : 'emap-light']} data-egypt-map>
  <svg viewBox={VB} class:list={[zoom && 'emap-zoom']} role="img" aria-label={lang === 'ar' ? 'خريطة مصر' : 'Map of Egypt'} dir="ltr">
    <defs>
      <linearGradient id="emap-sea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="currentColor" stop-opacity=".18" /><stop offset="1" stop-color="currentColor" stop-opacity=".05" /></linearGradient>
      <filter id="emap-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.4" /></filter>
    </defs>
    <rect class="sea" width={W} height={H} fill="url(#emap-sea)" />
    <path class="land" d={line(OUTLINE) + 'Z'} />
    <path class="coast draw" d={line(OUTLINE) + 'Z'} />
    <path class="nile draw" d={line(NILE)} />
    <path class="nile draw" d={line(ROSETTA)} />
    <path class="nile draw" d={line(DAMIETTA)} />
    <path class="nile nile-lake draw" d={line(NASSER)} />
    <path class="canal draw" d={line(SUEZ)} />
    <text class="sea-label" x={P(27.2, 31.72).x} y={P(27.2, 31.72).y}>{SEA}</text>
    <text class="sea-label" x={P(35.9, 25.3).x} y={P(35.9, 25.3).y} transform={`rotate(-62 ${P(35.9, 25.3).x} ${P(35.9, 25.3).y})`}>{RED}</text>
    <text class="nile-label" x={P(31.75, 27.5).x} y={P(31.75, 27.5).y} transform={`rotate(-72 ${P(31.75, 27.5).x} ${P(31.75, 27.5).y})`}>{NILE_L}</text>
    {routeD && <path class="route-glow" d={routeD} filter="url(#emap-glow)" />}
    {routeD && <path class="route draw" d={routeD} data-route-path />}
    {routeD && traveller && <path class="route-done" d={routeD} data-route-done />}}
    {pins.map((p) => {
      const o = lblOff(p.lbl); const inner = (
        <g class:list={['pin', p.minor && 'pin-minor', focus === p.id && 'active']} data-place={p.id} style={`--i:${p.i}`} tabindex={links ? undefined : 0}>
          <circle class="hit" cx={p.pos.x} cy={p.pos.y} r="16" />
          <circle class="halo" cx={p.pos.x} cy={p.pos.y} r="9" />
          <circle class="dot" cx={p.pos.x} cy={p.pos.y} r={p.minor ? 2.2 : 3.4} />
          {!p.quiet && <text class="lbl" x={p.pos.x + o.x} y={p.pos.y + o.y} text-anchor={o.a}>{p.label}</text>}
        </g>);
      return links && !p.minor ? <a href={path(lang, 'destination', p.id)} aria-label={pick(p.name, lang)}>{inner}</a> : inner;
    })}
    {routeD && traveller && (
      <g class="trav" data-trav data-cum={JSON.stringify(cum.map((c) => +c.toFixed(2)))} transform={`translate(${routeXY[0].x} ${routeXY[0].y})`}>
        <line class="trav-stem" x1="0" y1="0" x2="0" y2="-9" />
        <g transform="translate(0 -21)">
          <circle class="trav-pulse" r="12" />
          <circle class="trav-bg" r="11" />
          {Object.entries(TRAV).map(([k, d]) => <path class:list={['trav-ico', k === 'car' && 'on']} data-mode={k} d={d} transform="translate(-7.2 -7.2) scale(0.6)" />)}
        </g>
      </g>
    )}
    {focusP && <circle class="focus-ring" cx={P(focusP.at.lng, focusP.at.lat).x} cy={P(focusP.at.lng, focusP.at.lat).y} r="14" />}
    <g class="north" transform={`translate(${W - 22} 24)`}><path d="M0 -10 L5 5 L0 1 L-5 5 Z" /><text y="18" text-anchor="middle">N</text></g>
    <!-- scale bar under the north arrow, in the empty corner outside Egypt (the bottom edge is the southern border) -->
    <g class="scale" transform={`translate(${W - 18 - K * COS * 2} 54)`}><path d={`M0 0 H ${K * COS * 2}`} /><path d="M0 -3 V3" /><path d={`M${K * COS * 2} -3 V3`} /><text x={K * COS} y="13" text-anchor="middle">{lang === 'ar' ? '٢٠٠ كم' : '200 km'}</text></g>
  </svg>
  {!compact && <figcaption class="emap-cap"><Icon name="compass" size={14} /> {lang === 'ar' ? 'اضغط على دبوس لفتح صفحة الوجهة' : 'Tap a pin to open the destination'}</figcaption>}
</figure>

<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.25 });
  document.querySelectorAll('[data-egypt-map]').forEach((m) => io.observe(m));
</script>

<style>
  .emap { margin: 0; position: relative; border-radius: 6px; overflow: hidden; }
  .emap svg { width: 100%; height: auto; display: block; font-family: var(--sans); }
  .emap-dark { color: var(--papyrus); background: var(--nile-deep); }
  .emap-dark .land { fill: #1a3a50; }
  .emap-dark .coast { stroke: var(--gold); }
  .emap-dark .sea { color: #3b6f9c; }
  .emap-light { color: var(--ink); background: var(--paper); border: 1px solid var(--line); }
  .emap-light .land { fill: var(--sand); }
  .emap-light .coast { stroke: var(--gold-text); }
  .emap-light .sea { color: var(--lapis); }
  .coast { fill: none; stroke-width: 1.2; stroke-linejoin: round; }
  .nile { fill: none; stroke: #6fb0e0; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .emap-light .nile { stroke: var(--lapis); }
  .nile-lake { stroke-width: 3.2; opacity: 0.8; }
  .canal { fill: none; stroke: #6fb0e0; stroke-width: 0.8; stroke-dasharray: 2 2; }
  .emap-light .canal { stroke: var(--lapis); }
  .sea-label, .nile-label { font-size: 8.5px; letter-spacing: 0.14em; text-transform: uppercase; fill: currentColor; opacity: 0.55; }
  .nile-label { fill: #6fb0e0; opacity: 0.8; } .emap-light .nile-label { fill: var(--lapis); }
  html[lang='ar'] :is(.sea-label, .nile-label) { letter-spacing: 0; font-size: 9.5px; }
  .route { fill: none; stroke: var(--gold); stroke-width: 1.6; stroke-dasharray: 4 3; stroke-linecap: round; stroke-linejoin: round; }
  .route-glow { fill: none; stroke: var(--gold); stroke-width: 4; opacity: 0.35; }
  .pin { cursor: pointer; }
  .pin .dot { fill: var(--gold); stroke: var(--nile-deep); stroke-width: 1.2; transition: r 0.3s var(--ease); }
  .emap-light .pin .dot { stroke: var(--paper); }
  .pin .halo { fill: var(--gold); opacity: 0; }
  .pin .hit { fill: transparent; }
  .pin .lbl { font-size: 8.6px; font-weight: 700; fill: currentColor; paint-order: stroke; stroke: var(--nile-deep); stroke-width: 3px; stroke-linejoin: round; }
  .emap-light .pin .lbl { stroke: var(--paper); }
  html[lang='ar'] .pin .lbl { font-size: 9.5px; }
  .pin-minor .lbl { font-size: 7.4px; font-weight: 600; opacity: 0.75; }
  .pin:hover .dot, .pin.active .dot { r: 5; }
  .pin:hover .halo, .pin.active .halo { opacity: 0.3; }
  .pin.active .lbl { fill: var(--gold-light); }
  .emap-light .pin.active .lbl { fill: var(--gold-text); }
  /* traveller: a gold badge that rides the route as the reader scrolls the days (driven from Tour.astro) */
  .route-done { fill: none; stroke: var(--gold-light); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 0 99999; }
  .trav { opacity: 0; transition: opacity 0.6s var(--ease); }
  .emap.in .trav { opacity: 1; transition-delay: 2.6s; }
  .trav-stem { stroke: var(--gold); stroke-width: 1.6; }
  .trav-bg { fill: var(--gold); stroke: var(--nile-deep); stroke-width: 1.4; }
  .emap-light .trav-bg { stroke: var(--paper); }
  .trav-pulse { fill: none; stroke: var(--gold-light); stroke-width: 1; animation: travpulse 2s ease-out infinite; }
  @keyframes travpulse { 0% { r: 11; opacity: 0.9; } 100% { r: 22; opacity: 0; } }
  .trav-ico { fill: none; stroke: var(--nile-deep); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transition: opacity 0.25s; }
  .trav-ico.on { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .trav-pulse { animation: none; opacity: 0; } .emap.in .trav { transition-delay: 0s; } }
  /* zoomed maps: keep labels and pins at their usual on-screen size */
  .emap-zoom :is(.lbl, .sea-label, .nile-label) { font-size: 5px !important; } .emap-zoom .pin .dot { r: 2.2; } .emap-zoom .north, .emap-zoom .scale { display: none; }
  .focus-ring { fill: none; stroke: var(--gold); stroke-width: 1.2; opacity: 0.8; animation: ring 2.4s ease-out infinite; }
  @keyframes ring { 0% { r: 8; opacity: 0.9; } 100% { r: 22; opacity: 0; } }
  .north path { fill: var(--gold); } .north text, .scale text { font-size: 7.5px; fill: currentColor; opacity: 0.7; }
  .scale path { stroke: currentColor; stroke-width: 0.8; opacity: 0.7; }
  /* the caption sits in its own strip under the map; laid over the map it collided with the scale bar */
  .emap-cap { display: flex; gap: 6px; align-items: center; padding: 10px 14px; font-size: 0.8rem; color: currentColor; opacity: 0.75; border-top: 1px solid rgba(201, 162, 39, 0.25); }
  .emap-light .emap-cap { color: var(--stone); opacity: 1; border-top-color: var(--line); }
  @media (max-width: 640px) { .pin-minor .lbl { display: none; } .pin .lbl { font-size: 10px; } .sea-label { font-size: 9.5px; } .emap-cap { display: none; } }
  /* draw-in */
  .draw { stroke-dasharray: 2600; stroke-dashoffset: 2600; }
  .pin, .route-glow, .focus-ring { opacity: 0; }
  .emap.in .coast { animation: draw 2.4s var(--ease-out) forwards; }
  .emap.in .nile, .emap.in .canal { animation: draw 2.6s var(--ease-out) 0.6s forwards; }
  .emap.in .route { animation: draw 3s var(--ease-out) 1.6s forwards; }
  .emap.in .route-glow { animation: fade 1s var(--ease) 2.4s forwards; }
  .emap.in .pin { animation: pop 0.6s var(--ease-out) forwards; animation-delay: calc(1.2s + var(--i) * 0.07s); }
  .emap.in .focus-ring { animation: ring 2.4s ease-out 2s infinite; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @keyframes fade { to { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .draw { stroke-dashoffset: 0; } .pin, .route-glow { opacity: 1; } .route-glow { opacity: 0.35; } .emap.in * { animation: none !important; } .focus-ring { opacity: 0.8; } }
</style>
