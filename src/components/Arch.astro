---
/**
 * A Fatimid keel arch — the pointed arch of Al-Azhar and Al-Hakim — used as a photo window.
 * The slot is masked to the arch; a double gold outline sits just outside it and is revealed bottom-up when the
 * arch scrolls into view. (A stroke-dash "draw" can't be used: the outline stretches with the box, and dash
 * lengths don't resolve on a non-scaling, non-uniformly scaled path — it froze half drawn.)
 */
interface Props { class?: string; ratio?: string; line?: boolean; star?: boolean }
const { class: cls = '', ratio, line = true, star = true } = Astro.props;
const D = 'M0 140 L0 50 C0 24 24 8 50 0 C76 8 100 24 100 50 L100 140';
---
<div class={`arch-wrap rv ${cls}`} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <div class="arch"><slot /></div>
  {line && (
    <>
      <svg class="arch-line arch-line-1" viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true"><path d={D} vector-effect="non-scaling-stroke" /></svg>
      <svg class="arch-line arch-line-2" viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true"><path d={D} vector-effect="non-scaling-stroke" /></svg>
    </>
  )}
  {star && <svg class="arch-star" viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,0 61.86,21.36 85.36,14.64 78.64,38.14 100,50 78.64,61.86 85.36,85.36 61.86,78.64 50,100 38.14,78.64 14.64,85.36 21.36,61.86 0,50 21.36,38.14 14.64,14.64 38.14,21.36" /></svg>}
</div>
<style>
  .arch-wrap { position: relative; isolation: isolate; }
  .arch { position: absolute; inset: 0; overflow: hidden; -webkit-mask: var(--arch-mask) 0 0 / 100% 100% no-repeat; mask: var(--arch-mask) 0 0 / 100% 100% no-repeat; }
  .arch > :global(*) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .arch :global(.photo) { border-radius: 0; aspect-ratio: auto !important; }
  .arch-line { position: absolute; overflow: visible; pointer-events: none; z-index: 1; clip-path: inset(100% 0 0 0); transition: clip-path 1.8s var(--ease-out) 0.2s; }
  .arch-line-1 { inset: -9px -9px 0 -9px; width: calc(100% + 18px); height: calc(100% + 9px); }
  .arch-line-2 { inset: -4px -4px 0 -4px; width: calc(100% + 8px); height: calc(100% + 4px); transition-delay: 0.45s; }
  .arch-line path { fill: none; stroke: var(--gold); }
  .arch-line-1 path { stroke-width: 1.3; opacity: 0.8; } .arch-line-2 path { stroke-width: 0.7; opacity: 0.5; }
  .arch-star { position: absolute; top: 0; left: 50%; width: 16px; height: 16px; transform: translate(-50%, -170%) scale(0) rotate(-90deg); fill: var(--gold); z-index: 2; transition: transform 0.9s var(--ease-out) 1.4s; }
  .arch-wrap.in .arch-line, :global(html.no-js) .arch-line { clip-path: inset(0 0 0 0); }
  .arch-wrap.in .arch-star, :global(html.no-js) .arch-star { transform: translate(-50%, -170%) scale(1) rotate(0); }
  @media (prefers-reduced-motion: reduce) { .arch-line { clip-path: none; transition: none; } .arch-star { transform: translate(-50%, -170%); transition: none; } }
</style>
