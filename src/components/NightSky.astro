---
/**
 * A Giza night sky for the dark sections: stars that twinkle out of step, an occasional shooting star and,
 * optionally, a crescent moon. Positions come from a seeded generator so every build draws the same sky.
 * Absolutely positioned behind the section's content (the parent gets .has-sky, which lifts .wrap above it).
 */
interface Props { count?: number; seed?: number; moon?: boolean; class?: string }
const { count = 70, seed = 7, moon = false, class: cls = '' } = Astro.props;
let s = seed * 9301 + 49297;
const rnd = () => { s = (s * 9301 + 49297) % 233280; return s / 233280; };
const stars = Array.from({ length: count }, () => ({ x: rnd() * 100, y: rnd() * 100, r: 0.5 + rnd() * 1.3, d: (rnd() * 6).toFixed(2), t: (3 + rnd() * 4).toFixed(2) }));
---
<div class={`sky ${cls}`} aria-hidden="true">
  {stars.map((st) => <i class="star" style={`left:${st.x.toFixed(2)}%;top:${st.y.toFixed(2)}%;width:${(st.r * 2).toFixed(1)}px;height:${(st.r * 2).toFixed(1)}px;animation-delay:${st.d}s;animation-duration:${st.t}s`}></i>)}
  <i class="shoot"></i>
  {moon && <svg class="moon" viewBox="0 0 40 40"><path d="M27 4 A16 16 0 1 0 36 30 A13 13 0 1 1 27 4 Z" /></svg>}
</div>
<style>
  .sky { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .star { position: absolute; border-radius: 50%; background: #fff7dc; box-shadow: 0 0 6px rgba(255, 238, 190, 0.7); opacity: 0.5; animation: twinkle 4s ease-in-out infinite; }
  @keyframes twinkle { 0%, 100% { opacity: 0.15; transform: scale(0.8); } 50% { opacity: 0.9; transform: scale(1.15); } }
  .shoot { position: absolute; top: 18%; left: 70%; width: 120px; height: 1.4px; background: linear-gradient(90deg, rgba(255, 245, 210, 0.95), transparent); transform: rotate(-24deg); opacity: 0; animation: shoot 13s ease-in 4s infinite; }
  @keyframes shoot { 0%, 92% { opacity: 0; transform: rotate(-24deg) translateX(0); } 93% { opacity: 1; } 100% { opacity: 0; transform: rotate(-24deg) translateX(-420px); } }
  .moon { position: absolute; top: 12%; inset-inline-end: 9%; width: clamp(28px, 4vw, 46px); fill: #f6e7b8; filter: drop-shadow(0 0 14px rgba(246, 231, 184, 0.55)); }
  :global(.has-sky) { position: relative; overflow: hidden; }
  :global(.has-sky) > :global(.wrap) { position: relative; z-index: 1; }
  @media (prefers-reduced-motion: reduce) { .star, .shoot { animation: none; } .shoot { display: none; } }
</style>
