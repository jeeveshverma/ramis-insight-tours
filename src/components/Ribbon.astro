---
/**
 * The Nile divider: the river drawn as one gold line, with a felucca that sails along it as the divider crosses
 * the screen (scroll-linked). Fixed aspect, so the boat sits on the water at every width.
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const D = 'M0 34 C 110 18, 210 50, 320 34 S 530 18, 640 34 S 850 50, 960 34 S 1110 22, 1200 30';
---
<div class={`nile-div ${cls}`} data-nile>
  <svg class="ribbon rv" viewBox="0 -30 1200 100" aria-hidden="true">
    <path class="nile-w2" d={D} transform="translate(0 7)" />
    <path class="nile-w1" d={D} data-nile-path />
    <g class="felucca" data-felucca>
      <path class="fel-hull" d="M-17 -2 L17 -2 L12 4 L-12 4 Z" />
      <path class="fel-mast" d="M0 -2 V-34" />
      <path class="fel-sail" d="M1 -33 C 14 -24, 18 -12, 17 -4 L 1 -4 Z" />
      <path class="fel-boom" d="M-12 -40 L 18 -6" />
      <path class="fel-reflect" d="M-12 7 L12 7" />
    </g>
  </svg>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-nile]').forEach((root) => {
    const path = root.querySelector<SVGPathElement>('[data-nile-path]')!;
    const boat = root.querySelector<SVGGElement>('[data-felucca]')!;
    const L = path.getTotalLength();
    const rtl = document.documentElement.dir === 'rtl';
    const place = () => {
      const r = root.getBoundingClientRect();
      // 0 when the divider enters at the bottom of the screen, 1 when it leaves at the top
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
      const d = (rtl ? 1 - p : p) * L * 0.88 + L * 0.06;
      const a = path.getPointAtLength(d), b = path.getPointAtLength(Math.min(L, d + 2));
      const ang = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
      boat.setAttribute('transform', `translate(${a.x.toFixed(1)} ${a.y.toFixed(1)}) rotate(${(ang * 0.6).toFixed(1)}) scale(${rtl ? -1.5 : 1.5} 1.5)`);
    };
    let raf = 0;
    const on = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; place(); }); };
    place();
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { addEventListener('scroll', on, { passive: true }); addEventListener('resize', on); }
  });
</script>
<style>
  .nile-div { width: 100%; max-width: 1400px; margin-inline: auto; padding-inline: var(--gutter); }
  .nile-div .ribbon { height: auto; width: 100%; overflow: visible; color: var(--gold); }
  .nile-w1 { fill: none; stroke: var(--gold); stroke-width: 1.6; stroke-dasharray: 1400; stroke-dashoffset: 1400; }
  .nile-w2 { fill: none; stroke: var(--lapis); stroke-width: 1; opacity: 0.35; stroke-dasharray: 1400; stroke-dashoffset: 1400; }
  .ribbon.in .nile-w1, .ribbon.in .nile-w2, :global(html.no-js) .nile-w1 { animation: nile-draw 2.4s var(--ease-out) forwards; }
  .ribbon.in .nile-w2 { animation-delay: 0.3s; }
  @keyframes nile-draw { to { stroke-dashoffset: 0; } }
  .fel-hull { fill: var(--ink); }
  .fel-mast, .fel-boom { stroke: var(--ink); stroke-width: 1.4; fill: none; stroke-linecap: round; }
  .fel-sail { fill: var(--paper); stroke: var(--ink); stroke-width: 1.2; stroke-linejoin: round; }
  .fel-reflect { stroke: var(--lapis); stroke-width: 1; opacity: 0.4; }
  .felucca { opacity: 0; transition: opacity 0.8s var(--ease) 1.4s; }
  .ribbon.in .felucca { opacity: 1; }
  :global(.on-dark) .fel-hull, :global(.on-dark) .fel-mast, :global(.on-dark) .fel-boom { fill: var(--papyrus); stroke: var(--papyrus); }
  @media (prefers-reduced-motion: reduce) { .nile-w1, .nile-w2 { stroke-dashoffset: 0; animation: none !important; } .felucca { opacity: 1; transition: none; } }
</style>
