---
/**
 * The view at dusk from the edge of Giza, at the top of every footer: the Citadel's dome and pencil minarets,
 * the three pyramids, palms, the Nile with a felucca, a crescent moon and the first stars. Three silhouette
 * layers move at different speeds as the footer scrolls into view.
 */
import NightSky from './NightSky.astro';
---
<div class="skyline has-sky" data-skyline aria-hidden="true">
  <NightSky count={34} seed={11} moon />
  <div class="sk-glow"></div>
  <svg class="sk-layer sk-far" data-depth="0.25" viewBox="0 0 1440 220" preserveAspectRatio="xMidYMax slice">
    <path d="M0 220 V172 C 180 160, 300 168, 430 162 L 600 90 L 728 156 L 760 140 L 812 112 L 902 156 L 940 148 L 976 128 L 1030 156 C 1160 150, 1300 160, 1440 154 V220 Z" />
  </svg>
  <svg class="sk-layer sk-mid" data-depth="0.5" viewBox="0 0 1440 220" preserveAspectRatio="xMidYMax slice">
    <!-- Citadel of Saladin: Muhammad Ali mosque dome, half domes and two pencil minarets -->
    <g class="sk-cit">
    <path d="M120 220 V170 H140 V150 C140 128 170 114 200 114 C230 114 260 128 260 150 V170 H290 V220 Z M150 150 C150 140 160 134 168 134 C176 134 186 140 186 150 Z M214 150 C214 140 224 134 232 134 C240 134 250 140 250 150 Z" />
    <path d="M196 114 V104 L200 96 L204 104 V114 Z" />
    <path d="M110 220 V96 L114 72 L118 96 V220 Z M106 132 H122 V136 H106 Z" />
    <path d="M292 220 V96 L296 72 L300 96 V220 Z M288 132 H304 V136 H288 Z" />
    </g>
    <!-- palms -->
    <g class="sk-palms">
    <path d="M1180 220 V150 M1180 150 C1166 140 1150 142 1140 150 C1154 144 1168 146 1180 150 C1170 134 1156 128 1146 130 C1160 132 1172 140 1180 150 C1186 134 1200 128 1214 130 C1200 134 1190 142 1180 150 C1194 142 1210 142 1222 150 C1208 146 1192 146 1180 150 Z" class="sk-palm" />
    <path d="M1250 220 V164 M1250 164 C1240 156 1228 158 1220 164 C1232 160 1242 160 1250 164 C1244 152 1234 148 1226 150 C1236 152 1246 158 1250 164 C1256 152 1266 148 1276 150 C1266 152 1256 158 1250 164 C1260 158 1272 158 1280 164 C1270 160 1260 160 1250 164 Z" class="sk-palm" />
    </g>
    <path d="M0 220 V188 C 200 176, 380 190, 560 182 C 760 174, 960 188, 1140 180 C 1260 176, 1360 182, 1440 178 V220 Z" />
  </svg>
  <svg class="sk-layer sk-near" data-depth="0.8" viewBox="0 0 1440 220" preserveAspectRatio="xMidYMax slice">
    <path d="M0 220 V200 C 240 194, 520 204, 760 198 C 1000 192, 1220 202, 1440 196 V220 Z" />
    <path class="sk-river" d="M0 208 C 300 204, 640 212, 960 206 C 1160 203, 1320 208, 1440 206" />
    <g transform="translate(700 202)"><path d="M-16 0 L16 0 L11 5 L-11 5 Z" /><path d="M0 0 V-30" class="sk-line" /><path d="M1 -29 C 12 -21, 15 -10, 14 -3 L 1 -3 Z" class="sk-sail" /><path d="M-11 -35 L 16 -4" class="sk-line" /></g>
  </svg>
</div>
<script>
  const sk = document.querySelector<HTMLElement>('[data-skyline]');
  if (sk && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = [...sk.querySelectorAll<SVGElement>('[data-depth]')];
    let raf = 0;
    const move = () => {
      raf = 0;
      const r = sk.getBoundingClientRect();
      if (r.top > innerHeight || r.bottom < 0) return;
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / innerHeight)); // 0 entering → 1 fully in
      layers.forEach((l) => { const d = Number(l.dataset.depth); l.style.transform = `translateY(${((1 - p) * 40 * d).toFixed(1)}px)`; });
    };
    move();
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(move); }, { passive: true });
  }
</script>
<style>
  .skyline { position: relative; height: clamp(120px, 16vw, 220px); background: linear-gradient(180deg, #0c2c40 0%, #12405a 55%, #2a4f5c 80%, #3e5560 100%); overflow: hidden; }
  .sk-glow { position: absolute; inset: auto 0 0 0; height: 70%; background: radial-gradient(ellipse 45% 70% at 52% 100%, rgba(232, 160, 74, 0.45), transparent 70%); pointer-events: none; }
  .sk-layer { position: absolute; inset: auto 0 0 0; width: 100%; height: 100%; will-change: transform; }
  .sk-far path { fill: #1b4256; }
  .sk-mid path { fill: #0f3043; }
  .sk-mid .sk-palm { fill: #0f3043; stroke: #0f3043; stroke-width: 3; }
  .sk-near path { fill: var(--nile-deep); }
  .sk-near .sk-river { fill: none; stroke: rgba(224, 185, 58, 0.45); stroke-width: 1.4; }
  .sk-near .sk-line { fill: none; stroke: var(--nile-deep); stroke-width: 1.6; }
  .sk-near .sk-sail { fill: var(--nile-deep); }
  .skyline :global(.sky) { height: 70%; }
  /* phones only show the middle ~700 units of the 1440-wide scene: bring the Citadel and palms into it */
  @media (max-width: 720px) { .sk-cit { transform: translateX(240px); } .sk-palms { transform: translateX(-160px); } }
</style>
