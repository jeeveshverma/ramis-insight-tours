---
import Layout from '../components/Layout.astro';
import EgyptMap from '../components/EgyptMap.astro';
import NightSky from '../components/NightSky.astro';
import Fanous from '../components/Fanous.astro';
import { useT, path } from '../i18n';
const { t } = useT('en');
---
<Layout lang="en" page="notfound" title={`${t('notfound.title')} · Rami's Insight Tours`} desc={t('notfound.text')} noindex dark>
  <section class="section dark-deep on-dark nf has-sky">
    <NightSky count={90} seed={13} moon />
    <div class="wrap nf-in">
      <div class="nf-copy">
        <Fanous class="nf-fanous" chain={40} id="nf-fanous" />
        <p class="eyebrow">404</p>
        <h1>{t('notfound.title')}</h1>
        <p class="lead">{t('notfound.text')}</p>
        <p><a class="btn btn-gold" href={path('en', 'home')}>{t('notfound.cta')}</a> <a class="btn btn-outline" href={path('ar', 'home')} lang="ar">العربية</a></p>
      </div>
      <EgyptMap lang="en" compact links={false} />
    </div>
  </section>
</Layout>
<style>
  .nf { min-height: 100vh; display: grid; align-items: center; padding-top: calc(var(--header-h) + 40px); }
  .nf-in { display: grid; gap: 40px; align-items: center; }
  .nf h1 { margin: 16px 0; }
  .nf-copy { position: relative; } .nf-copy :global(.nf-fanous) { position: absolute; top: -96px; inset-inline-end: 4%; }
  @media (min-width: 960px) { .nf-in { grid-template-columns: 1fr 1fr; } }
</style>
