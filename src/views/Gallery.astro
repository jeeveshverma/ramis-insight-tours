---
import Layout from '../components/Layout.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import { useT, pick, type Lang } from '../i18n';
import { SITE } from '../data/site';
import { PHOTOS, type Cat } from '../data/photos';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
const cats: Cat[] = ['giza', 'cairo', 'nile', 'alexandria', 'desert', 'stay', 'people', 'food'];
const photos = PHOTOS.filter((p) => p.cat !== 'video' && p.id !== 'logo-original' && p.id !== 'rami-door-small' && !p.id.endsWith('-door'));
---
<Layout lang={lang} page="gallery" title={`${t('nav.gallery')} · ${SITE.name[lang]}`} desc={t('gallery.lead')}>
  <section class="section ph">
    <div class="wrap">
      <div class="section-head rv" data-ar="صور"><p class="eyebrow">{t('gallery.eyebrow')}</p><h1>{t('gallery.title')}</h1><p class="lead">{t('gallery.lead')}</p></div>
      <div class="gchips rv" data-gchips><button class="chip" aria-pressed="true" data-cat="">{t('gallery.cats.all')}</button>{cats.map((c) => <button class="chip" aria-pressed="false" data-cat={c}>{t(`gallery.cats.${c}`)}</button>)}</div>
      <div class="masonry" data-masonry>
        {photos.map((p, i) => <button class="gitem rv" data-cat={p.cat} data-i={i} aria-label={pick(p.alt, lang)}><Img id={p.id} lang={lang} sizes="(min-width:960px) 33vw, 50vw" widths={[420, 640, 900]} /><span class="gcap">{pick(p.alt, lang)}</span></button>)}
      </div>
    </div>
  </section>
  <dialog class="lb" data-lb>
    <button class="lb-x btn ic" data-close aria-label={t('gallery.close')}><Icon name="close" /></button>
    <button class="lb-nav lb-prev" data-prev aria-label={t('gallery.prev')}><Icon name="arrowLeft" /></button>
    <figure><img alt="" data-img loading="lazy" /><figcaption data-cap></figcaption></figure>
    <button class="lb-nav lb-next" data-next aria-label={t('gallery.next')}><Icon name="arrowRight" /></button>
  </dialog>
</Layout>

<script>
  const chips = document.querySelector<HTMLElement>('[data-gchips]'); const grid = document.querySelector<HTMLElement>('[data-masonry]'); const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  if (chips && grid && lb) {
    const items = [...grid.querySelectorAll<HTMLElement>('.gitem')];
    chips.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => b.addEventListener('click', () => { chips.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); const c = b.dataset.cat || ''; items.forEach((it) => { it.hidden = !!c && it.dataset.cat !== c; }); }));
    const img = lb.querySelector<HTMLImageElement>('[data-img]')!, cap = lb.querySelector<HTMLElement>('[data-cap]')!;
    let cur = 0;
    const visible = () => items.filter((i) => !i.hidden);
    const show = (el: HTMLElement) => { const src = el.querySelector('img')!; img.src = src.currentSrc || src.src; img.alt = src.alt; cap.textContent = src.alt; cur = visible().indexOf(el); };
    items.forEach((it) => it.addEventListener('click', () => { show(it); lb.showModal(); }));
    const step = (d: number) => { const v = visible(); show(v[(cur + d + v.length) % v.length]); };
    lb.querySelector('[data-prev]')!.addEventListener('click', () => step(-1)); lb.querySelector('[data-next]')!.addEventListener('click', () => step(1));
    lb.querySelector('[data-close]')!.addEventListener('click', () => lb.close());
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); });
  }
</script>

<style>
  .ph { padding-top: calc(var(--header-h) + clamp(32px, 6vw, 72px)); }
  .gchips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .masonry { columns: 2; column-gap: 12px; }
  @media (min-width: 960px) { .masonry { columns: 3; column-gap: 16px; } }
  .gitem { display: block; width: 100%; break-inside: avoid; margin-bottom: 12px; border: 0; padding: 0; background: none; cursor: zoom-in; position: relative; text-align: start; border-radius: var(--radius); overflow: hidden; }
  .gitem[hidden] { display: none; }
  .gitem :global(.photo) { border-radius: var(--radius); }
  .gitem :global(img) { transition: transform 1s var(--ease-out); }
  .gitem:hover :global(img) { transform: scale(1.04); }
  .gcap { position: absolute; inset-inline: 0; bottom: 0; padding: 28px 12px 10px; font-size: 0.8rem; color: var(--papyrus); background: linear-gradient(180deg, transparent, rgba(7, 32, 47, 0.8)); opacity: 0; transition: opacity 0.3s; }
  .gitem:hover .gcap, .gitem:focus-visible .gcap { opacity: 1; }
  .lb { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; }
  .lb::backdrop { background: rgba(7, 32, 47, 0.96); }
  .lb figure { margin: 0; width: 100%; height: 100%; display: grid; grid-template-rows: 1fr auto; place-items: center; padding: 60px 16px 24px; }
  .lb img { max-width: 100%; max-height: calc(100vh - 130px); object-fit: contain; border-radius: 4px; }
  .lb figcaption { color: var(--papyrus); padding-top: 12px; text-align: center; font-size: 0.95rem; }
  .lb-x { position: fixed; top: 14px; inset-inline-end: 14px; width: 48px; height: 48px; padding: 0; border-radius: 50%; background: rgba(246, 240, 227, 0.1); border-color: transparent; color: var(--papyrus); }
  .lb-nav { position: fixed; top: 50%; transform: translateY(-50%); width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(246, 240, 227, 0.3); background: rgba(7, 32, 47, 0.5); color: var(--papyrus); display: grid; place-items: center; cursor: pointer; }
  .lb-prev { inset-inline-start: 12px; } .lb-next { inset-inline-end: 12px; }
  html[dir='rtl'] .lb-nav svg { transform: scaleX(-1); }
</style>
