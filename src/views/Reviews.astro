---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import VideoCard from '../components/VideoCard.astro';
import FilmFeature from '../components/FilmFeature.astro';
import { useT, digits, type Lang } from '../i18n';
import { SITE } from '../data/site';
import { REVIEWS, VIDEOS } from '../data/reviews';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
---
<Layout lang={lang} page="reviews" title={`${t('nav.reviews')} · ${SITE.name[lang]}`} desc={t('reviews.lead')}>
  <section class="section ph">
    <div class="wrap">
      <div class="section-head rv"><p class="eyebrow">{t('reviews.eyebrow')}</p><h1>{t('reviews.title')}</h1><p class="lead">{t('reviews.lead')}</p></div>
      <div class="badges rv">
        <a class="badge card" href={SITE.bookingUrl} target="_blank" rel="noopener"><b>{SITE.ratings.booking.score}</b><span>Booking.com<br /><small class="muted">{t('stay.reviews', { n: digits(SITE.ratings.booking.count, lang) })}</small></span><Icon name="arrowUpRight" size={16} /></a>
        <a class="badge card" href={SITE.mapsSearchUrl} target="_blank" rel="noopener"><b>{SITE.ratings.google.score}<Icon name="starFill" size={18} /></b><span>Google<br /><small class="muted">{t('stay.reviews', { n: digits(SITE.ratings.google.count, lang) })}</small></span><Icon name="arrowUpRight" size={16} /></a>
        <a class="badge card" href={SITE.instagram.url} target="_blank" rel="noopener"><b><Icon name="instagram" size={26} /></b><span>{t('reviews.instagram')}<br /><small class="muted">@{SITE.instagram.handle}</small></span><Icon name="arrowUpRight" size={16} /></a>
      </div>
      <div class="grid-3 stagger" style="margin-top:36px">{REVIEWS.map((r) => <ReviewCard lang={lang} review={r} />)}</div>
    </div>
  </section>
  <section class="section dark on-dark pattern">
    <div class="wrap">
      <div class="section-head rv"><p class="eyebrow">{t('reviews.videos')}</p><h2>{t('reviews.videosTitle')}</h2><p class="lead">{t('reviews.videosText')}</p></div>
      <div class="grid-3 stagger">{VIDEOS.map((v) => <VideoCard lang={lang} video={v} />)}</div>
    </div>
  </section>
  <FilmFeature lang={lang} />
</Layout>
<style>
  .ph { padding-top: calc(var(--header-h) + clamp(32px, 6vw, 72px)); }
  .badges { display: grid; gap: 14px; }
  .badge { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 18px 20px; text-decoration: none; color: inherit; }
  .badge b { font-family: var(--display); font-size: 2.2rem; color: var(--gold-text); display: inline-flex; align-items: center; gap: 4px; line-height: 1; } .badge span { font-weight: 700; color: var(--ink); line-height: 1.3; } .badge small { font-weight: 500; }
  @media (min-width: 720px) { .badges { grid-template-columns: repeat(3, 1fr); } }
</style>
