---
import Layout from '../components/Layout.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import EgyptMap from '../components/EgyptMap.astro';
import TourCard from '../components/TourCard.astro';
import { useT, path, pick, type Lang } from '../i18n';
import { SITE } from '../data/site';
import { place as getPlace, type PlaceId } from '../data/places';
import { TOURS } from '../data/tours';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const { t } = useT(lang);
const p = getPlace(id as PlaceId);
const name = pick(p.name, lang);
const tours = TOURS.filter((x) => x.route.includes(p.id) && x.style !== 'custom');
---
<Layout lang={lang} page="destination" sub={p.id} title={`${name} · ${SITE.name[lang]}`} desc={pick(p.blurb, lang)} overHero={!!p.photo}>
  {p.photo ? (
    <section class="dh">
      <div class="dh-media"><Img id={p.photo} lang={lang} vt={`dest-${p.id}`} priority sizes="100vw" widths={[640, 960, 1280, 1680]} quality={68} /><div class="dh-shade"></div></div>
      <div class="wrap dh-in on-dark"><a class="th-back" href={path(lang, 'destinations')}><Icon name="arrowLeft" class="rtl-flip" size={16} /> {t('nav.destinations')}</a><p class="eyebrow">{t('dest.eyebrow')}</p><h1>{name}</h1></div>
    </section>
  ) : (
    <section class="dh-plain"><div class="wrap"><a class="th-back" href={path(lang, 'destinations')}><Icon name="arrowLeft" class="rtl-flip" size={16} /> {t('nav.destinations')}</a><p class="eyebrow">{t('dest.eyebrow')}</p><h1>{name}</h1></div></section>
  )}
  <section class="section">
    <div class="wrap d-in">
      <div class="rv">
        <p class="lead intro-lead">{pick(p.blurb, lang)}</p>
        <dl class="rows">
          <div><dt><Icon name="sun" size={16} /> {t('dest.best')}</dt><dd>{pick(p.best, lang)}</dd></div>
          <div><dt><Icon name="compass" size={16} /> {t('dest.tip')}</dt><dd>{pick(p.tip, lang)}</dd></div>
        </dl>
      </div>
      <div class="rv rv-d1"><p class="eyebrow" style="margin-bottom:12px">{t('dest.map')}</p><EgyptMap lang={lang} compact focus={p.id} dark={false} /></div>
    </div>
  </section>
  {tours.length > 0 && (
    <section class="section sand-bg">
      <div class="wrap"><div class="section-head rv"><p class="eyebrow">{t('dest.tours')}</p><h2>{t('dest.toursThrough', { place: pick(p.short ?? p.name, lang) })}</h2></div><div class="grid-3 stagger">{tours.map((x) => <TourCard lang={lang} tour={x} />)}</div></div>
    </section>
  )}
</Layout>
<style>
  html[dir='rtl'] :global(.rtl-flip) { transform: scaleX(-1); }
  .th-back { display: inline-flex; gap: 6px; align-items: center; text-decoration: none; font-weight: 700; font-size: 0.9rem; opacity: 0.85; margin-bottom: 12px; }
  .dh { position: relative; min-height: 64svh; display: grid; align-items: end; padding-top: var(--header-h); background: var(--nile-deep); overflow: hidden; }
  .dh-media { position: absolute; inset: 0; } .dh-media :global(.photo) { position: absolute; inset: 0; height: 100%; border-radius: 0; }
  .dh-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 32, 47, 0.4), rgba(7, 32, 47, 0) 35%, rgba(7, 32, 47, 0.92) 100%); }
  .dh-in { position: relative; padding-bottom: clamp(36px, 6vh, 72px); display: grid; gap: 10px; }
  .dh-plain { padding-top: calc(var(--header-h) + clamp(32px, 6vw, 72px)); } .dh-plain h1 { margin-top: 10px; }
  .intro-lead { font-size: clamp(1.1rem, 1.8vw, 1.4rem); line-height: 1.5; color: var(--ink); margin-bottom: 28px; }
  .rows dt { display: flex; gap: 8px; align-items: center; } .rows dt svg { color: var(--gold-text); }
  .d-in { display: grid; gap: 40px; align-items: start; } @media (min-width: 960px) { .d-in { grid-template-columns: 1.1fr 0.9fr; gap: 64px; } }
</style>
