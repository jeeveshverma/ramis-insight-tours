---
import Layout from '../components/Layout.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Ribbon from '../components/Ribbon.astro';
import StayMap from '../components/StayMap.astro';
import TourCard from '../components/TourCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { useT, path, pick, digits, usd, type Lang } from '../i18n';
import { SITE } from '../data/site';
import { stay as getStay, type StayId } from '../data/stays';
import { TOURS } from '../data/tours';
import { REVIEWS, VIDEOS } from '../data/reviews';
import VideoCard from '../components/VideoCard.astro';
import LightShow from '../components/LightShow.astro';
import ArabicMark from '../components/ArabicMark.astro';
import Khayamiya from '../components/Khayamiya.astro';
import NightSky from '../components/NightSky.astro';
import Mashrabiya from '../components/Mashrabiya.astro';
import { waUrl, mailUrl } from '../lib/wa';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const { t } = useT(lang);
const s = getStay(id as StayId);
const name = pick(s.name, lang);
const soon = s.status === 'coming_soon';
const wa = waUrl(soon ? t('stay.soonWa') : t('stay.waMsg'));
const reviews = REVIEWS.filter((r) => r.about !== 'tour');
const facts: [string, string][] = [['walk', 'sphinx'], ['bed', 'rooms'], ['breakfast', 'breakfast'], ['show', 'rooftop'], ['wifi', 'wifi'], ['plane', 'airport']];
const scores = SITE.ratings.booking;
const tours = TOURS.filter((x) => x.stays.some((st) => st.kind === 'guesthouse')).slice(0, 3);
const jsonld = soon ? [] : [{
  '@context': 'https://schema.org', '@type': 'LodgingBusiness', name: s.name.en, description: s.intro.en, url: `${SITE.url}${path('en', 'stay', s.id)}`, telephone: SITE.phone, email: SITE.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Sayed Gabir Street, Al Haram', addressLocality: 'Giza', postalCode: SITE.postal, addressCountry: 'EG' },
  geo: { '@type': 'GeoCoordinates', latitude: s.geo!.lat, longitude: s.geo!.lng }, checkinTime: '13:00', checkoutTime: '11:00', petsAllowed: true, numberOfRooms: s.rooms.length,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: SITE.ratings.google.score, bestRating: 5, reviewCount: SITE.ratings.google.count },
  amenityFeature: ['Free Wi-Fi', 'Rooftop terrace', 'Free breakfast', 'Air conditioning', 'Airport shuttle', 'Family rooms', 'Pets allowed'].map((n) => ({ '@type': 'LocationFeatureSpecification', name: n, value: true })),
  containsPlace: s.rooms.map((r) => ({ '@type': 'HotelRoom', name: r.name.en, floorSize: { '@type': 'QuantitativeValue', value: r.m2, unitCode: 'MTK' }, occupancy: { '@type': 'QuantitativeValue', maxValue: r.guests } })),
}];
---
<Layout lang={lang} page="stay" sub={s.id} title={`${name} · ${SITE.name[lang]}`} desc={pick(s.tagline, lang) + '. ' + pick(s.intro, lang).slice(0, 120)} overHero jsonld={jsonld} dark={soon}>
  {soon ? (
    <section class="soon dark-deep on-dark has-sky">
      <NightSky count={90} seed={4} moon />
      <Mashrabiya variant="screen" fade="left" id="soon-lattice" />
      <ArabicMark word="الأقصر" tone="dark" class="soon-mark" />
      <div class="wrap soon-in">
        <svg class="soon-ribbon" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 20 C 50 4, 100 36, 150 20 S 250 4, 300 20 S 400 36, 450 20 S 550 4, 600 20" /></svg>
        <p class="eyebrow">{pick(s.place, lang)}</p>
        <h1>{name}</h1>
        <p class="soon-title ital">{t('stay.soonTitle')}</p>
        <p class="lead">{pick(s.intro, lang)}</p>
        <p class="muted">{t('stay.soonText')}</p>
        <div class="soon-cta">
          <a class="btn btn-gold btn-lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('stay.soonCta')}</a>
          <a class="btn btn-outline btn-lg" href={mailUrl(t('stay.soonCta'))}><Icon name="mail" /> {t('contact.email')}</a>
        </div>
        <a class="soon-back" href={path(lang, 'stays')}><Icon name="arrowLeft" class="rtl-flip" size={16} /> {t('nav.stays')}</a>
      </div>
    </section>
  ) : (
    <>
      <!-- HERO -->
      <section class="sh">
        <div class="sh-media"><Img id={s.hero} lang={lang} vt={`stay-${s.id}`} priority sizes="100vw" widths={[640, 960, 1280, 1680]} quality={70} /><div class="sh-glow" aria-hidden="true"></div><div class="sh-shade"></div></div>
        <div class="wrap sh-in on-dark">
          <a class="th-back" href={path(lang, 'stays')}><Icon name="arrowLeft" class="rtl-flip" size={16} /> {t('nav.stays')}</a>
          <p class="eyebrow">{name} · {pick(s.place, lang)}</p>
          <h1>{pick(s.tagline, lang)}</h1>
          {lang !== 'ar' && <p class="h-ar" lang="ar">{s.name.ar}</p>}
          <div class="sh-ratings">
            <span class="rating"><b>{digits(scores.score, lang)}</b><span>{t('stay.ratingBooking')}<br /><small>{t('stay.reviews', { n: digits(scores.count, lang) })}</small></span></span>
            <span class="rating"><b>{digits(SITE.ratings.google.score, lang)}<Icon name="starFill" size={16} /></b><span>{t('stay.ratingGoogle')}<br /><small>{t('stay.reviews', { n: digits(SITE.ratings.google.count, lang) })}</small></span></span>
            <span class="cartouche"><small>{t('common.from')}</small><b>{usd(s.from!)}</b><small>/ {t('common.night')}</small></span>
          </div>
          <div class="sh-cta">
            <a class="btn btn-wa btn-lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('stay.ctaWa')}</a>
            <a class="btn btn-outline btn-lg" href="#rooms">{t('stay.ctaRooms')}</a>
          </div>
        </div>
      </section>
      <Khayamiya />

      <!-- FACTS -->
      <section class="facts">
        <div class="wrap facts-in">{facts.map(([icon, k]) => <div class="fact"><Icon name={icon} size={22} /><span>{t(`stay.facts.${k}`)}</span></div>)}</div>
      </section>

      <!-- INTRO + WHY -->
      <section class="section">
        <div class="wrap wrap-narrow rv"><p class="lead intro-lead">{pick(s.intro, lang)}</p></div>
      </section>
      <section class="section-tight why">
        <div class="wrap">
          <div class="section-head rv" style="margin-bottom:28px"><p class="eyebrow">{t('stay.whyEyebrow')}</p></div>
          <div class="why-list">
            {s.why.map((w, i) => (
              <article class:list={['why-item rv', i % 2 && 'why-flip']}>
                <div class="frame ls-wrap"><Img id={w.photo} lang={lang} ratio="4/3" sizes="(min-width:960px) 50vw, 100vw" widths={[640, 960, 1345]} />{w.photo === 'rooftop-night-pyramids' && <LightShow id={`ls-${i}`} />}</div>
                <div class="why-text"><span class="marker">{digits(String(i + 1).padStart(2, '0'), lang)}</span><h2>{pick(w.title, lang)}</h2><p class="lead">{pick(w.text, lang)}</p></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <Ribbon />

      <!-- ROOMS -->
      <section class="section" id="rooms">
        <div class="wrap">
          <div class="section-head rv"><p class="eyebrow">{t('stay.roomsEyebrow')}</p><h2>{t('stay.roomsTitle')}</h2><p class="lead">{t('stay.roomsText')}</p></div>
          <div class="rooms stagger">
            {s.rooms.map((r) => (
              <article class="room card">
                <div class="room-media" data-carousel>
                  <div class="room-track">{r.photos.map((ph, j) => <Img id={ph} lang={lang} ratio="4/3" sizes="(min-width:1100px) 25vw, (min-width:640px) 50vw, 100vw" widths={[420, 640, 900]} />)}</div>
                  <span class="room-m2"><b>{digits(r.m2, lang)}</b> {t('stay.m2')}</span>
                  {r.photos.length > 1 && <span class="room-dots" aria-hidden="true">{r.photos.map((_, j) => <i class:list={[j === 0 && 'on']}></i>)}</span>}
                  {r.photos.length > 1 && <button class="room-nav room-prev" type="button" aria-label={t('gallery.prev')}><Icon name="arrowLeft" size={18} class="rtl-flip" /></button>}
                  {r.photos.length > 1 && <button class="room-nav room-next" type="button" aria-label={t('gallery.next')}><Icon name="arrowRight" size={18} class="rtl-flip" /></button>}
                </div>
                <div class="room-body">
                  {r.door && <span class="room-door"><svg viewBox="0 0 20 18" width="16" aria-hidden="true"><path d="M10 1 L19 17 H1 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>{lang === 'ar' ? 'الغرفة' : 'Room'} {digits(r.door.n, lang)} · {pick(r.door.name, lang)}</span>}
                  <h3>{pick(r.name, lang)}</h3>
                  <ul class="room-facts"><li><Icon name="bed" size={15} /> {pick(r.beds, lang)}</li><li><Icon name="users" size={15} /> {t('stay.guests', { n: digits(r.guests, lang) })}</li><li><Icon name="terrace" size={15} /> {t('stay.terrace')}</li></ul>
                  {r.note && <p class="muted small">{pick(r.note, lang)}</p>}
                  <div class="room-row"><span class="cartouche"><small>{t('common.from')}</small><b>{usd(s.from!)}</b></span><a class="btn btn-sm btn-outline" href={waUrl(t('stay.waRoom', { room: pick(r.name, lang) }))} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> {t('stay.askRoom')}</a></div>
                </div>
              </article>
            ))}
          </div>
          <details class="compare rv">
            <summary class="btn btn-ghost"><Icon name="ruler" size={18} /> {t('stay.compare')}</summary>
            <table class="ctable">
              <thead><tr><th>{t('stay.room')}</th><th>{t('stay.size')}</th><th>{t('stay.beds')}</th><th>{t('stay.sleeps')}</th></tr></thead>
              <tbody>{s.rooms.map((r) => <tr><th>{pick(r.name, lang)}</th><td class="num">{digits(r.m2, lang)} {t('stay.m2')}</td><td>{pick(r.beds, lang)}</td><td class="num">{digits(r.guests, lang)}</td></tr>)}</tbody>
            </table>
          </details>
        </div>
      </section>

      <!-- MAP -->
      <section class="section sand-bg">
        <div class="wrap">
          <div class="section-head rv"><p class="eyebrow">{t('stay.mapEyebrow')}</p><h2>{t('stay.mapTitle')}</h2><p class="lead">{t('stay.mapText')}</p></div>
          <div class="rv rv-d1"><StayMap lang={lang} /></div>
          <p class="map-links"><a class="btn btn-outline btn-sm" href={SITE.mapsSearchUrl} target="_blank" rel="noopener"><Icon name="pin" size={16} /> {t('stay.openMap')}</a> <span class="muted small">{pick(s.address!, lang)}</span></p>
        </div>
      </section>

      <!-- AMENITIES -->
      <section class="section">
        <div class="wrap">
          <div class="section-head rv"><p class="eyebrow">{t('stay.amenEyebrow')}</p><h2>{t('stay.amenTitle')}</h2></div>
          <div class="amen stagger">
            {s.amenities.map((g) => (
              <div class="amen-group">
                <h3>{pick(g.title, lang)}</h3>
                <ul>{g.items.map((it) => <li><Icon name={it.icon} size={20} /><span>{pick(it.label, lang)}{it.paid && <small class="muted"> · {t('stay.paid')}</small>}</span></li>)}</ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- GALLERY -->
      <section class="section-tight">
        <div class="wrap">
          <div class="section-head rv" style="margin-bottom:24px"><p class="eyebrow">{t('stay.galleryEyebrow')}</p><h2>{t('stay.galleryTitle')}</h2></div>
          <div class="sgal stagger">{s.photos.map((p, i) => <div class:list={['sgal-item', i === 0 && 'sgal-big']}><Img id={p} lang={lang} ratio={i === 0 ? '16/9' : '1/1'} sizes={i === 0 ? '(min-width:960px) 66vw, 100vw' : '(min-width:960px) 33vw, 50vw'} /></div>)}</div>
        </div>
      </section>

      <!-- REVIEWS -->
      <section class="section dark on-dark pattern">
        <div class="wrap rev-in">
          <div class="rv">
            <p class="eyebrow">{t('stay.reviewsEyebrow')}</p>
            <h2>{t('stay.reviewsTitle')}</h2>
            <div class="scores">
              {([['staff', scores.staff], ['wifi', scores.wifi], ['clean', scores.clean], ['location', scores.location]] as [string, number][]).map(([k, v]) => <div class="score"><span>{t(`stay.scores.${k}`)}</span><div class="bar"><i style={`--p:${v * 10}%`}></i></div><b>{digits(v, lang)}</b></div>)}
            </div>
            <p class="muted small">{t('stay.ratingBooking')} · {t('stay.reviews', { n: digits(scores.count, lang) })}</p>
            <a class="btn btn-outline" href={SITE.bookingUrl} target="_blank" rel="noopener">{t('stay.ctaBooking')} <Icon name="arrowUpRight" size={16} /></a>
            <div class="rev-video"><VideoCard lang={lang} video={VIDEOS[0]} /></div>
          </div>
          <div class="grid-2 stagger">{reviews.slice(0, 4).map((r) => <ReviewCard lang={lang} review={r} />)}</div>
        </div>
      </section>

      <!-- RULES -->
      <section class="section">
        <div class="wrap rules-in">
          <div class="rv"><p class="eyebrow">{t('stay.rulesEyebrow')}</p><h2>{t('stay.rulesTitle')}</h2></div>
          <dl class="rows rv rv-d1">{s.rules.map((r) => <div><dt>{pick(r.label, lang)}</dt><dd>{pick(r.value, lang)}</dd></div>)}</dl>
        </div>
      </section>

      <!-- STAY + TOUR -->
      <section class="section sand-bg">
        <div class="wrap">
          <div class="section-head rv"><p class="eyebrow">{t('stay.toursEyebrow')}</p><h2>{t('stay.toursTitle')}</h2><p class="lead">{t('stay.toursText')}</p></div>
          <div class="grid-3 stagger">{tours.map((x) => <TourCard lang={lang} tour={x} />)}</div>
        </div>
      </section>

      <!-- ENQUIRE -->
      <section class="section" id="enquire">
        <div class="wrap enq-in">
          <div class="rv"><p class="eyebrow">{t('stay.enquireEyebrow')}</p><h2>{t('stay.enquireTitle')}</h2><p class="lead">{t('stay.enquireText')}</p><a class="btn btn-wa btn-lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('stay.ctaWa')}</a></div>
          <div class="rv rv-d1"><EnquiryForm lang={lang} interest="stay" /></div>
        </div>
      </section>
    </>
  )}
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
    const track = c.querySelector<HTMLElement>('.room-track')!; const dots = [...c.querySelectorAll('.room-dots i')]; const next = c.querySelector('.room-next'); const prev = c.querySelector('.room-prev');
    const idx = () => Math.round(Math.abs(track.scrollLeft) / track.clientWidth);
    track.addEventListener('scroll', () => { const i = idx(); dots.forEach((d, j) => d.classList.toggle('on', j === i)); }, { passive: true });
    const go = (d: number) => { const n = (idx() + d + dots.length) % dots.length; const dir = document.documentElement.dir === 'rtl' ? -1 : 1; track.scrollTo({ left: dir * n * track.clientWidth, behavior: 'smooth' }); };
    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => { const n = (idx() + 1) % dots.length; const dir = document.documentElement.dir === 'rtl' ? -1 : 1; track.scrollTo({ left: dir * n * track.clientWidth, behavior: 'smooth' }); });
  });
</script>

<style>
  html[dir='rtl'] :global(.rtl-flip) { transform: scaleX(-1); }
  .th-back { display: flex; width: fit-content; gap: 6px; align-items: center; text-decoration: none; font-weight: 700; font-size: 0.9rem; opacity: 0.85; }
  .sh { position: relative; min-height: 86svh; display: grid; align-items: end; padding-top: var(--header-h); background: var(--nile-deep); overflow: hidden; }
  .sh-media { position: absolute; inset: 0; } .sh-media :global(.photo) { position: absolute; inset: 0; height: 100%; border-radius: 0; }
  .sh-media :global(img) { animation: kb 30s var(--ease) infinite alternate; }
  @keyframes kb { from { transform: scale(1); } to { transform: scale(1.08) translate(1%, -1%); } }
  .sh-glow { position: absolute; inset: 0; background: radial-gradient(ellipse 28% 22% at 70% 34%, rgba(224, 185, 58, 0.5), transparent 70%); mix-blend-mode: screen; animation: glow 6s ease-in-out infinite alternate; }
  @keyframes glow { from { opacity: 0.25; } to { opacity: 0.85; } }
  /* the sunset sky is near-white at the top, so the header needs a darker band there to stay readable */
  .sh-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7, 32, 47, 0.6) 0%, rgba(7, 32, 47, 0.25) 45%, rgba(7, 32, 47, 0) 70%), linear-gradient(180deg, rgba(7, 32, 47, 0.72), rgba(7, 32, 47, 0.2) 26%, rgba(7, 32, 47, 0.15) 45%, rgba(7, 32, 47, 0.94) 100%); }
  html[dir='rtl'] .sh-shade { background: linear-gradient(-90deg, rgba(7, 32, 47, 0.6) 0%, rgba(7, 32, 47, 0.25) 45%, rgba(7, 32, 47, 0) 70%), linear-gradient(180deg, rgba(7, 32, 47, 0.72), rgba(7, 32, 47, 0.2) 26%, rgba(7, 32, 47, 0.15) 45%, rgba(7, 32, 47, 0.94) 100%); }
  .sh-in .eyebrow { color: var(--papyrus); } .sh-in .eyebrow::before { background: var(--papyrus); }
  .sh-in { position: relative; padding-bottom: clamp(40px, 7vh, 80px); display: grid; gap: 14px; }
  .sh h1 { font-size: clamp(2.4rem, 7vw, 5.2rem); max-width: 12em; }
  .sh-ratings { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; margin-top: 6px; }
  .rating { display: inline-flex; gap: 10px; align-items: center; font-size: 0.85rem; line-height: 1.25; }
  .rating b { font-family: var(--display); font-size: 2rem; color: var(--gold-light); display: inline-flex; align-items: center; gap: 4px; }
  .rating small { opacity: 0.7; }
  .sh-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
  @media (prefers-reduced-motion: reduce) { .sh-media :global(img), .sh-glow { animation: none; } }

  .facts { background: var(--paper); border-bottom: 1px solid var(--line); }
  .facts-in { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 20px; padding-block: 20px; }
  .fact { display: flex; gap: 10px; align-items: center; font-weight: 600; font-size: 0.95rem; color: var(--ink); } .fact svg { color: var(--gold-text); flex: none; }
  @media (min-width: 720px) { .facts-in { grid-template-columns: repeat(3, 1fr); } } @media (min-width: 1100px) { .facts-in { grid-template-columns: repeat(6, auto); justify-content: space-between; } }
  .intro-lead { font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1.5; color: var(--ink); }

  .why-list { display: grid; gap: 48px; }
  .ls-wrap { overflow: visible; } .ls-wrap :global(.photo) { position: relative; } .ls-wrap :global(.lightshow) { border-radius: var(--radius); }
  .why-item { display: grid; gap: 24px; align-items: center; }
  .why-text { position: relative; display: grid; gap: 10px; } .why-text .marker { position: absolute; top: -62px; inset-inline-start: -4px; }
  .why-text { padding-top: 24px; }
  .why-text h2 { font-size: clamp(1.8rem, 3.6vw, 2.8rem); } .why-text .lead { margin: 0; }
  @media (min-width: 960px) { .why-item { grid-template-columns: 1fr 1fr; gap: 64px; } .why-flip .frame { order: 2; } .why-list { gap: 72px; } }

  .rooms { display: grid; gap: 20px; }
  .room { display: grid; }
  /* room photo carousel: native scroll-snap, swipe on phones, arrow on desktop, dots follow the scroll */
  .room-media { position: relative; }
  .room-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .room-track::-webkit-scrollbar { display: none; }
  .room-track > :global(.photo) { flex: 0 0 100%; scroll-snap-align: start; border-radius: 0; }
  .room-m2 { position: absolute; bottom: 12px; inset-inline-start: 12px; background: rgba(7, 32, 47, 0.78); color: var(--papyrus); backdrop-filter: blur(6px); padding: 5px 12px; border-radius: 999px; font-size: 0.82rem; font-weight: 600; }
  .room-m2 b { font-family: var(--display); font-size: 1.15rem; font-weight: 500; }
  .room-dots { position: absolute; bottom: 14px; inset-inline-end: 12px; display: flex; gap: 5px; padding: 6px 8px; border-radius: 999px; background: rgba(7, 32, 47, 0.6); }
  .room-dots i { width: 6px; height: 6px; border-radius: 50%; background: rgba(246, 240, 227, 0.55); transition: background 0.3s, transform 0.3s; }
  .room-dots i.on { background: var(--gold-light); transform: scale(1.3); }
  .room-nav { position: absolute; top: 50%; inset-inline-end: 10px; transform: translateY(-50%); width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(251, 247, 238, 0.92); color: var(--ink); display: grid; place-items: center; cursor: pointer; opacity: 0; transition: opacity 0.3s; box-shadow: var(--shadow-sm); }
  .room-prev { inset-inline-end: auto; inset-inline-start: 10px; }
  .room:hover .room-nav, .room-nav:focus-visible { opacity: 1; }
  @media (hover: none) { .room-nav { display: none; } }
  .room-door { display: inline-flex; gap: 6px; align-items: center; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold-text); }
  html[lang='ar'] .room-door { letter-spacing: 0; font-size: 0.9rem; }
  .room-body { padding: 18px 20px 22px; display: grid; gap: 10px; }
  .room-body h3 { font-size: 1.3rem; }
  .room-facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 0.92rem; } .room-facts li { display: flex; gap: 8px; align-items: center; } .room-facts svg { color: var(--gold-text); }
  .room-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-top: 6px; }
  @media (min-width: 640px) { .rooms { grid-template-columns: 1fr 1fr; } } @media (min-width: 1100px) { .rooms { grid-template-columns: repeat(4, 1fr); } .rooms .room:nth-child(n+5) { grid-column: span 1; } }
