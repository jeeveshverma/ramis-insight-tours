---
import Layout from '../components/Layout.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Ribbon from '../components/Ribbon.astro';
import Arch from '../components/Arch.astro';
import Mashrabiya from '../components/Mashrabiya.astro';
import Khayamiya from '../components/Khayamiya.astro';
import ArabicMark from '../components/ArabicMark.astro';
import Fanous from '../components/Fanous.astro';
import NightSky from '../components/NightSky.astro';
import Birds from '../components/Birds.astro';
import EgyptMap from '../components/EgyptMap.astro';
import TourCard from '../components/TourCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import VideoCard from '../components/VideoCard.astro';
import FilmFeature from '../components/FilmFeature.astro';
import { useT, path, pick, digits, usd, type Lang } from '../i18n';
import { SITE } from '../data/site';
import { FEATURED, TOURS } from '../data/tours';
import { GUEST_HOUSE } from '../data/stays';
import { REVIEWS, VIDEOS } from '../data/reviews';
import { POSTS } from '../data/posts';
import { waUrl } from '../lib/wa';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
const words = t('hero.title').split(' ');
const years = new Date().getFullYear() - SITE.founded;
const ways = [
  { k: 'history', icon: 'temple', photo: 'temple-light-shaft' },
  { k: 'culture', icon: 'tea', photo: 'family-food-spread' },
  { k: 'hidden', icon: 'compass', photo: 'desert-sunset-arms' },
];
const posts = POSTS.slice(0, 3);
const wa = waUrl(lang === 'ar' ? 'مرحباً رامي، أود التخطيط لرحلة إلى مصر.' : "Hi Rami, I'd like to plan a trip to Egypt.");
---
<Layout lang={lang} page="home" title={`${SITE.name[lang]} · ${t('hero.title')}`} desc={t('hero.sub')} overHero>
  <!-- HERO: a keel-arch window onto Rami's film, set in a mashrabiya screen -->
  <section class="hero on-dark">
    <Mashrabiya variant="screen" fade="left" id="hero-lattice" />
    <div class="hero-glow" aria-hidden="true"></div>
    <ArabicMark word="مصر" tone="dark" class="hero-mark" />
    <Birds />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">{SITE.city[lang]} · {t('footer.madeWith')}</p>
        <h1 class="hero-title" aria-label={t('hero.title')}>{words.map((w, i) => <span class="w" style={`--i:${i}`} aria-hidden="true">{w}</span>)}</h1>
        <p class="hero-sub lead">{t('hero.sub')}</p>
        <div class="hero-cta">
          <a class="btn btn-gold btn-lg" href={path(lang, 'tours')}>{t('hero.cta')} <Icon name="arrowRight" class="rtl-flip" /></a>
          <a class="btn btn-outline btn-lg" href={path(lang, 'stay', GUEST_HOUSE.id)}>{t('hero.cta2')}</a>
        </div>
        <p class="hero-proof"><Icon name="starFill" size={14} /> {SITE.ratings.google.score} Google <span>·</span> {SITE.ratings.booking.score} Booking.com <span>·</span> {lang === 'ar' ? 'منذ' : 'since'} {digits(SITE.founded, lang)}</p>
      </div>
      <div class="hero-window">
        <Fanous class="hero-fanous" chain={64} id="hero-fanous" />
        <Arch class="hero-arch" ratio="5/7">
          <Img id="pyramids-golden-hour" lang={lang} priority sizes="(min-width:960px) 34vw, 82vw" widths={[480, 720, 960, 1280]} quality={70} position="58% 60%" />
          <!-- Silent loop cut from Rami's film; src is set by script only when motion and data allow, then it fades in over the photo. -->
          <video class="hero-video" data-hero-video data-src={`${import.meta.env.BASE_URL}media/hero-loop.mp4`} muted loop playsinline preload="none" aria-hidden="true"></video>
        </Arch>
        <p class="hero-cap"><span lang="ar" dir="rtl" class="hero-cap-ar">بعدسة رامي</span> {lang === 'ar' ? 'لقطات صوّرها رامي' : 'Filmed by Rami'}</p>
      </div>
    </div>
  </section>
  <Khayamiya />

  <!-- STATS -->
  <section class="stats" id="stats">
    <div class="wrap stats-in">
      {([[years, 0, lang === 'ar' ? 'سنة من الإرشاد' : 'years guiding', ''], [SITE.ratings.google.score, 1, t('stats.google'), 'star'], [SITE.ratings.booking.score, 1, t('stats.booking'), ''], [800, 0, t('stats.sphinx'), ''], [TOURS.length, 0, t('stats.tours'), '']] as [number, number, string, string][]).map(([n, dec, label, icon], i) => (
        <div class={`stat rv rv-d${i}`}>
          <span class="stat-n num" data-count={n} data-dec={dec || undefined}>{dec ? n.toFixed(dec) : digits(n, lang)}</span>
          {lang !== 'ar' && <span class="stat-ar" lang="ar" aria-hidden="true">{digits(dec ? n.toFixed(dec) : n, 'ar').replace('.', '٫')}</span>}
          <span class="stat-l">{label} {icon && <Icon name="starFill" size={13} />}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- INTRO -->
  <section class="section intro">
    <Mashrabiya variant="shadow" id="intro-shade" />
    <Fanous class="intro-fanous" chain={110} id="intro-fanous" />
    <div class="wrap intro-in">
      <div class="intro-text section-head rv" data-ar="أهلاً">
        <p class="eyebrow">{t('home.introEyebrow')}</p>
        <h2>{t('home.introTitle')}</h2>
        <p class="lead">{t('home.intro1')}</p>
        <p>{t('home.intro2')}</p>
        <a class="btn btn-ghost" href={path(lang, 'about')}>{t('home.teamCta')} <Icon name="arrowRight" class="rtl-flip" size={18} /></a>
      </div>
      <div class="intro-photos">
        <div class="frame rv rv-d1"><Img id="rami-guests-selfie" lang={lang} ratio="4/3" sizes="(min-width:960px) 40vw, 100vw" /></div>
        <div class="frame intro-small rv rv-d2"><Img id="grandfather-1964" lang={lang} ratio="4/5" sizes="200px" widths={[286]} /></div>
        <span class="intro-caption ital">{lang === 'ar' ? 'جدّي، 1964' : 'My grandfather, 1964'}</span>
      </div>
    </div>
  </section>

  <Ribbon />

  <!-- THREE WAYS -->
  <section class="section ways">
    <div class="wrap">
      <div class="section-head rv" data-ar="طريقنا"><p class="eyebrow">{t('home.waysEyebrow')}</p></div>
      <div class="ways-grid">
        {ways.map((w, i) => (
          <article class="way">
            <Arch class="way-photo" ratio="3/4"><Img id={w.photo} lang={lang} sizes="(min-width:960px) 30vw, 100vw" /></Arch>
            <span class="marker way-n" lang="ar" aria-hidden="true">{'١٢٣'[i]}</span>
            <div class="way-body">
              <Icon name={w.icon} size={28} class="way-icon" />
              <h3>{t(`home.ways.${w.k}.title`)}</h3>
              <p>{t(`home.ways.${w.k}.text`)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MAP -->
  <section class="section dark on-dark mapsec has-sky">
    <NightSky count={80} seed={5} moon />
    <div class="wrap mapsec-in">
      <div class="section-head rv" data-ar="مصر" style="margin-bottom:0">
        <p class="eyebrow">{t('home.mapEyebrow')}</p>
        <h2>{t('home.mapTitle')}</h2>
        <p class="lead">{t('home.mapText')}</p>
        <a class="btn btn-outline" href={path(lang, 'destinations')}>{t('dest.all')} <Icon name="arrowRight" class="rtl-flip" size={18} /></a>
      </div>
      <div class="rv rv-d1"><EgyptMap lang={lang} /></div>
    </div>
  </section>

  <!-- TOURS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head rv" data-ar="رحلات">
        <p class="eyebrow">{t('home.toursEyebrow')}</p>
        <h2>{t('home.toursTitle')}</h2>
        <p class="lead">{t('home.toursText')}</p>
      </div>
      <div class="grid-4 stagger">{FEATURED.slice(0, 4).map((x) => <TourCard lang={lang} tour={x} />)}</div>
      <p class="center-cta rv"><a class="btn btn-lg" href={path(lang, 'tours')}>{t('home.allTours')} <Icon name="arrowRight" class="rtl-flip" /></a></p>
    </div>
  </section>

  <!-- GUEST HOUSE -->
  <section class="gh dark-deep on-dark">
    <Khayamiya size="sm" class="gh-khay" />
    <div class="gh-media">
      <Img id="rooftop-sunset-sign" lang={lang} sizes="(min-width:960px) 55vw, 100vw" widths={[640, 960, 1280]} class="gh-img" vt={`stay-${GUEST_HOUSE.id}`} />
      <div class="gh-glow" aria-hidden="true"></div>
      <div class="gh-shade"></div>
    </div>
    <div class="wrap gh-in">
      <div class="gh-text section-head rv" data-ar="بيتنا">
        <p class="eyebrow">{t('home.stayEyebrow')}</p>
        <h2>{t('home.stayTitle')}</h2>
        <p class="lead">{t('home.stayText')}</p>
        <ul class="gh-facts">
          <li><Icon name="walk" size={18} /> {t('stay.facts.sphinx')}</li>
          <li><Icon name="bed" size={18} /> {t('stay.facts.rooms')}</li>
          <li><Icon name="breakfast" size={18} /> {t('stay.facts.breakfast')}</li>
          <li><Icon name="show" size={18} /> {t('stay.facts.rooftop')}</li>
        </ul>
        <div class="gh-row">
          <span class="cartouche"><small>{t('home.from')}</small><b>{usd(GUEST_HOUSE.from!)}</b><small>/ {t('home.night')}</small></span>
          <span class="pill"><Icon name="starFill" size={13} /> {SITE.ratings.booking.score} Booking</span>
          <span class="pill"><Icon name="starFill" size={13} /> {SITE.ratings.google.score} Google</span>
        </div>
        <a class="btn btn-gold btn-lg" href={path(lang, 'stay', GUEST_HOUSE.id)}>{t('home.stayCta')} <Icon name="arrowRight" class="rtl-flip" /></a>
      </div>
    </div>
  </section>

  <!-- HOSTS -->
  <section class="section hosts">
    <div class="wrap hosts-in">
      <div class="hosts-photos rv">
        <div class="frame"><Img id="rami-guest-pyramids" lang={lang} ratio="4/3" sizes="(min-width:960px) 45vw, 100vw" /></div>
        <div class="hosts-small frame"><Img id="rami-door-small" lang={lang} ratio="4/5" sizes="180px" widths={[286]} /></div>
      </div>
      <div class="section-head rv rv-d1" data-ar="العيلة">
        <p class="eyebrow">{t('home.teamEyebrow')}</p>
        <h2>{t('home.teamTitle')}</h2>
        <p class="lead">{t('home.teamText')}</p>
        <a class="btn btn-outline" href={path(lang, 'about')}>{t('home.teamCta')} <Icon name="arrowRight" class="rtl-flip" size={18} /></a>
      </div>
    </div>
  </section>

  <FilmFeature lang={lang} />

  <!-- GUEST VIDEOS + REVIEWS MARQUEE -->
  <section class="section-tight reviews sand-bg">
    <div class="wrap section-head rv" style="margin-bottom:28px" data-ar="قالوا">
      <p class="eyebrow">{t('home.reviewsEyebrow')}</p>
      <h2>{t('home.reviewsTitle')}</h2>
      <p class="lead">{t('reviews.videosText')}</p>
    </div>
    <div class="wrap grid-3 stagger home-videos">{VIDEOS.map((v) => <VideoCard lang={lang} video={v} />)}</div>
    <div class="marquee" data-marquee>
      <div class="marquee-track">
        {[...REVIEWS, ...REVIEWS].map((r) => <div class="marquee-item"><ReviewCard lang={lang} review={r} /></div>)}
      </div>
    </div>
    <p class="center-cta wrap"><a class="btn btn-ghost" href={path(lang, 'reviews')}>{t('home.allReviews')} <Icon name="arrowRight" class="rtl-flip" size={18} /></a></p>
  </section>

  <!-- JOURNAL -->
  <section class="section">
    <div class="wrap">
      <div class="section-head rv" data-ar="حكايات"><p class="eyebrow">{t('home.journalEyebrow')}</p><h2>{t('home.journalTitle')}</h2></div>
      <div class="grid-3 stagger">
        {posts.map((p) => (
          <a class="post-card card" href={path(lang, 'post', p.id)}>
            <Img id={p.hero} lang={lang} ratio="16/10" sizes="(min-width:960px) 30vw, 100vw" />
            <div class="post-body"><span class="muted small">{t('journal.read', { n: digits(p.minutes, lang) })}</span><h3>{pick(p.title, lang)}</h3><p class="muted">{pick(p.dek, lang)}</p></div>
          </a>
        ))}
      </div>
      <p class="center-cta rv"><a class="btn btn-ghost" href={path(lang, 'journal')}>{t('home.allPosts')} <Icon name="arrowRight" class="rtl-flip" size={18} /></a></p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section dark on-dark cta has-sky">
    <NightSky count={50} seed={9} />
    <Mashrabiya variant="screen" fade="left" id="cta-lattice" />
    <div class="wrap cta-in">
      <div class="section-head rv" data-ar="أهلاً وسهلاً" style="margin-bottom:0">
        <p class="eyebrow">{t('nav.contact')}</p>
        <h2>{t('home.ctaTitle')}</h2>
        <p class="lead">{t('home.ctaText')}</p>
        <a class="btn btn-wa btn-lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('nav.whatsapp')}</a>
        <p class="muted small" style="margin-top:14px">{t('contact.hours')}</p>
      </div>
      <div class="rv rv-d1"><EnquiryForm lang={lang} /></div>
    </div>
  </section>
</Layout>

<script>
  // Hero loop: only when the visitor allows motion and is not on Data Saver / a 2G link. Fades in once it is really playing,
  // and pauses when the hero scrolls out of view so it never costs battery off-screen.
  const hv = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (hv) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const ok = !matchMedia('(prefers-reduced-motion: reduce)').matches && !conn?.saveData && !/(^|-)2g$/.test(conn?.effectiveType || '');
    if (ok) {
      hv.src = hv.dataset.src!;
      hv.addEventListener('playing', () => hv.classList.add('on'), { once: true });
      hv.play().catch(() => { /* autoplay refused: the photo stays, which is the intended fallback */ });
      new IntersectionObserver(([e]) => { if (e.isIntersecting) hv.play().catch(() => {}); else hv.pause(); }).observe(hv);
    }
  }
  // pause marquee on hover/touch; speed from item count
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((m) => {
    const track = m.querySelector<HTMLElement>('.marquee-track')!;
    track.style.setProperty('--n', String(track.children.length / 2));
    m.addEventListener('pointerenter', () => track.style.animationPlayState = 'paused');
    m.addEventListener('pointerleave', () => track.style.animationPlayState = 'running');
  });
</script>

<style>
  /* HERO — dusk-blue ground, mashrabiya screen, a warm sun behind a keel-arch window */
  .hero { position: relative; min-height: 100svh; padding-top: calc(var(--header-h) + 24px); padding-bottom: 56px; overflow: hidden; display: grid; align-items: center;
    background: radial-gradient(ellipse 60% 70% at 72% 55%, #1d4a62 0%, var(--nile) 45%, var(--nile-deep) 100%); }
  html[dir='rtl'] .hero { background: radial-gradient(ellipse 60% 70% at 28% 55%, #1d4a62 0%, var(--nile) 45%, var(--nile-deep) 100%); }
  .hero-glow { position: absolute; width: 60vmin; height: 60vmin; inset-inline-end: 12%; top: 22%; border-radius: 50%; background: radial-gradient(circle, rgba(232, 160, 74, 0.38), transparent 65%); filter: blur(10px); animation: sunpulse 9s ease-in-out infinite alternate; pointer-events: none; }
  @keyframes sunpulse { from { opacity: 0.6; transform: scale(0.94); } to { opacity: 1; transform: scale(1.06); } }
  .hero-grid { position: relative; z-index: 2; display: grid; gap: 36px; align-items: center; }
  .hero-copy { position: relative; display: grid; gap: 18px; justify-items: start; }
  /* مصر, large, anchored low behind the copy like a signature; the section crops its bottom */
  .hero :global(.hero-mark) { font-size: clamp(8rem, 22vw, 17rem); bottom: -0.12em; inset-inline-start: 0.02em; top: auto; opacity: 0.09; z-index: 1; }
  .hero-eyebrow { opacity: 0; animation: up 0.9s var(--ease-out) 0.2s forwards; }
  .hero-title { max-width: 11em; display: flex; flex-wrap: wrap; gap: 0 0.26em; font-size: clamp(2.7rem, 7vw, 5.6rem); }
  .hero-title .w { display: inline-block; opacity: 0; transform: translateY(0.5em) rotate(1deg); animation: word 1s var(--ease-out) forwards; animation-delay: calc(0.35s + var(--i) * 0.09s); }
  @keyframes word { to { opacity: 1; transform: none; } }
  @keyframes up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .hero-sub { max-width: 30em; opacity: 0; animation: up 0.9s var(--ease-out) 1.1s forwards; font-size: clamp(1.05rem, 1.5vw, 1.25rem); margin: 0; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; opacity: 0; animation: up 0.9s var(--ease-out) 1.3s forwards; }
  .hero-proof { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; margin: 4px 0 0; font-size: 0.88rem; color: rgba(246, 240, 227, 0.7); opacity: 0; animation: up 0.9s var(--ease-out) 1.5s forwards; }
  .hero-proof svg { color: var(--gold-light); } .hero-proof span { opacity: 0.5; }
  /* phones: the headline comes first so the first screen says who this is; the arch follows */
  .hero-window { position: relative; justify-self: center; width: min(72vw, 360px); margin-top: 40px; }
  .hero-window :global(.hero-arch) { width: 100%; box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8); }
  .hero-window :global(img) { animation: kb 28s var(--ease) infinite alternate; transform-origin: 60% 60%; }
  @keyframes kb { from { transform: scale(1); } to { transform: scale(1.12) translate(-2%, 1%); } }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.6s var(--ease); }
  .hero-video.on { opacity: 1; }
  /* the lantern hangs beside the arch's shoulder; its chain runs up out of the hero */
  .hero-window :global(.hero-fanous) { position: absolute; inset-inline-start: -46px; top: -30px; transform: scale(0.62); transform-origin: top center; z-index: 3;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 46px); mask-image: linear-gradient(180deg, transparent 0, #000 46px); }
  .hero-cap { display: flex; gap: 10px; align-items: baseline; justify-content: center; margin: 18px 0 0; font-size: 0.82rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(246, 240, 227, 0.6); }
  .hero-cap-ar { font-family: 'Aref Ruqaa', 'Amiri', serif; font-size: 1.35rem; letter-spacing: 0; text-transform: none; color: var(--gold-light); }
  html[lang='ar'] .hero-cap { letter-spacing: 0; text-transform: none; }
  @media (min-width: 960px) {
    .hero { padding-bottom: 72px; }
    .hero-grid { grid-template-columns: 1.1fr 0.9fr; gap: 64px; }
    .hero-window { width: min(34vw, 460px); margin-top: 0; }
    .hero-window :global(.hero-fanous) { inset-inline-start: -104px; top: -20px; transform: none; }
  }
  @media (max-width: 959px) { .hero-copy :global(.hero-mark) { top: -0.3em; } }
  @media (prefers-reduced-motion: reduce) { .hero-glow, .hero-window :global(img) { animation: none; } .hero-title .w, .hero-eyebrow, .hero-sub, .hero-cta, .hero-proof { animation: none; opacity: 1; transform: none; } }
  .home-videos { margin-bottom: 40px; }

  /* STATS — on papyrus under the khayamiya, each figure echoed in Arabic numerals */
  .stats { padding-block: 34px; background: var(--paper); border-bottom: 1px solid var(--line); }
  .stats-in { display: grid; grid-template-columns: repeat(2, 1fr); gap: 26px 16px; }
  .stat { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 10px; align-items: baseline; position: relative; }
  .stat-n { font-size: clamp(2.1rem, 4.4vw, 3.2rem); color: var(--ink); line-height: 1; font-variation-settings: 'opsz' 144, 'SOFT' 50; }
  .stat-ar { font-family: 'Reem Kufi', 'Amiri', serif; font-weight: 700; font-size: clamp(1.1rem, 2vw, 1.5rem); color: var(--gold); opacity: 0.85; }
  .stat-l { grid-column: 1 / -1; margin-top: 6px; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--stone); display: inline-flex; gap: 6px; align-items: center; font-weight: 600; }
  .stat-l :global(svg) { color: var(--gold); }
  html[lang='ar'] .stat-l { letter-spacing: 0; text-transform: none; font-size: 0.95rem; }
  @media (min-width: 720px) { .stats-in { grid-template-columns: repeat(5, 1fr); } .stats { padding-block: 44px; } .stat + .stat { padding-inline-start: 22px; border-inline-start: 1px solid var(--line); } }

  /* INTRO — sunlight through a mashrabiya on the wall; a fanous hangs between the columns */
  .intro { overflow: hidden; }
  .intro :global(.intro-fanous) { position: absolute; top: 0; inset-inline-start: calc(50% - 40px); z-index: 2; display: none; }
  @media (min-width: 960px) { .intro :global(.intro-fanous) { display: block; } }
  .intro-in { display: grid; gap: 40px; align-items: center; position: relative; z-index: 1; }
  .intro-text { margin-bottom: 0; }
  .intro-text h2 { margin: 14px 0 18px; }
  .intro-photos { position: relative; padding-bottom: 60px; }
  .intro-small { position: absolute; bottom: 0; inset-inline-end: 8%; width: 32%; box-shadow: var(--shadow); background: var(--papyrus); }
  .intro-caption { position: absolute; bottom: 10px; inset-inline-start: 0; color: var(--stone); font-size: 1.05rem; }
  @media (min-width: 960px) { .intro-in { grid-template-columns: 1fr 1.1fr; gap: 72px; } }

  /* THREE WAYS — an arcade: three keel arches side by side, numbered in Arabic numerals */
  .ways-grid { display: grid; gap: 44px; }
  .way { position: relative; display: grid; gap: 18px; }
  .way :global(.way-photo) { width: 100%; }
