---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import { useT, pick, digits, type Lang } from '../i18n';
import en from '../i18n/en.json';
import ar from '../i18n/ar.json';
import { SITE } from '../data/site';
import { TIPS, WEATHER } from '../data/tips';
import { waUrl } from '../lib/wa';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
const months = (lang === 'ar' ? ar : en).tips.months as string[];
const color = (s: number) => ['#b5542e', '#c9743a', '#c9a227', '#8aa86a', '#4f8a5a'][s - 1];
const wa = waUrl(lang === 'ar' ? 'مرحباً رامي، عندي سؤال قبل السفر: ' : 'Hi Rami, I have a question before I travel: ');
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: TIPS.map((x) => ({ '@type': 'Question', name: x.q.en, acceptedAnswer: { '@type': 'Answer', text: x.a.map((a) => a.en).join(' ') } })) };
---
<Layout lang={lang} page="tips" title={`${t('nav.tips')} · ${SITE.name[lang]}`} desc={t('tips.lead')} jsonld={[faq]}>
  <section class="section ph">
    <div class="wrap">
      <div class="section-head rv" data-ar="نصايح"><p class="eyebrow">{t('tips.eyebrow')}</p><h1>{t('tips.title')}</h1><p class="lead">{t('tips.lead')}</p></div>
      <div class="weather rv">
        <h2>{t('tips.weatherTitle')}</h2>
        <p class="muted">{t('tips.weatherText')}</p>
        <div class="wstrip" role="img" aria-label={t('tips.weatherTitle')}>
          {WEATHER.map((w, i) => (
            <div class="wm" style={`--c:${color(w.score)}; --h:${(w.cairo - 15) / 30 * 100}%; --l:${(w.luxor - 15) / 30 * 100}%`}>
              <span class="wtemps"><b title={t('tips.luxor')}>{digits(w.luxor, lang)}°</b><small title={t('tips.cairo')}>{digits(w.cairo, lang)}°</small></span>
              <span class="wbars"><i class="wl"></i><i class="wc"></i></span>
              <span class="wlabel">{months[i]}</span>
            </div>
          ))}
        </div>
        <p class="wkey small muted"><span><i style="background:var(--gold-text)"></i> {t('tips.cairo')}</span><span><i style="background:var(--terracotta)"></i> {t('tips.luxor')}</span></p>
      </div>
      <div class="faq rv">
        {TIPS.map((x) => (
          <details class="acc">
            <summary><Icon name={x.icon} size={22} class="acc-i" /><span>{pick(x.q, lang)}</span><Icon name="plus" size={20} class="acc-x" /></summary>
            <div class="acc-body">{x.a.map((a) => <p>{pick(a, lang)}</p>)}</div>
          </details>
        ))}
      </div>
      <p class="rv" style="margin-top:36px"><a class="btn btn-wa btn-lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('tips.more')}</a></p>
    </div>
  </section>
</Layout>
<style>
  .ph { padding-top: calc(var(--header-h) + clamp(32px, 6vw, 72px)); }
  .weather { margin-bottom: 48px; padding: 24px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); }
  .weather h2 { font-size: 1.6rem; margin-bottom: 6px; }
  .wstrip { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 4px; margin-top: 20px; align-items: end; }
  .wm { display: grid; gap: 6px; justify-items: center; }
  .wtemps { display: grid; justify-items: center; line-height: 1; } .wtemps b { font-family: var(--display); font-size: 0.95rem; color: var(--ink); } .wtemps small { font-size: 0.7rem; color: var(--stone); }
  .wbars { display: flex; gap: 2px; align-items: flex-end; height: 90px; width: 100%; justify-content: center; }
  .wbars i { display: block; width: 36%; border-radius: 2px 2px 0 0; transform-origin: bottom; animation: grow 1.2s var(--ease-out) both; }
  .wl { height: var(--l); background: var(--c); } .wc { height: var(--h); background: var(--c); opacity: 0.55; }
  @keyframes grow { from { transform: scaleY(0); } }
  .wlabel { font-size: 0.7rem; font-weight: 700; color: var(--stone); letter-spacing: 0.04em; }
  .wkey { display: flex; gap: 18px; margin: 14px 0 0; } .wkey span { display: inline-flex; gap: 6px; align-items: center; } .wkey i { width: 12px; height: 12px; border-radius: 2px; display: inline-block; }
  @media (max-width: 640px) { .weather { padding: 18px 14px; } .wstrip { gap: 2px; } .wm { min-width: 0; } .wtemps small { display: none; } .wtemps b { font-size: 0.78rem; } .wlabel { font-size: 0.58rem; letter-spacing: 0; } }
  .faq { max-width: 860px; }
</style>
